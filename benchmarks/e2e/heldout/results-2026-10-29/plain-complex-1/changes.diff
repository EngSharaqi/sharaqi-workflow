+    });
+});
+
+describe('errors', () => {
+    test('missing root dependency: ENOTFOUND', () => {
+        const error = expectCode(() => resolve({ a: { '1.0.0': {} } }, { a: '*', nope: '^1.0.0' }), 'ENOTFOUND');
