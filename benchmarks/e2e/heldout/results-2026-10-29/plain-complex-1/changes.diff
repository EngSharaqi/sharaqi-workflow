-// Dependency resolver. Not implemented yet.
+// Dependency resolver: chronological backtracking over packages in the order
+// they are first needed (breadth-first), newest satisfying version first.
+
+const NUM = '(0|[1-9]\\d*)';
+const VERSION_RE = new RegExp(`^${NUM}\\.${NUM}\\.${NUM}$`);
+const COMPARATOR_RE = new RegExp(`^(<=|>=|<|>|=|\\^|~)?${NUM}\\.${NUM}\\.${NUM}$`);
+
+function parseVersion(str) {
+    const m = typeof str === 'string' ? VERSION_RE.exec(str) : null;
+    return m ? [BigInt(m[1]), BigInt(m[2]), BigInt(m[3])] : null;
+}
+
+function compare(a, b) {
+    for (let i = 0; i < 3; i++) {
+        if (a[i] !== b[i]) return a[i] < b[i] ? -1 : 1;
+    }
+    return 0;
+}
+
+const TESTS = {
+    '=': (c) => c === 0,
+    '>': (c) => c > 0,
+    '>=': (c) => c >= 0,
+    '<': (c) => c < 0,
+    '<=': (c) => c <= 0,
+};
+
+// Turns one comparator token into a list of primitive { op, v } checks.
+function parseComparator(token) {
+    if (token === '*') return [];
+    const m = COMPARATOR_RE.exec(token);
+    if (!m) return null;
+    const op = m[1] || '=';
+    const v = [BigInt(m[2]), BigInt(m[3]), BigInt(m[4])];
+    const [major, minor, patch] = v;
+    if (op === '^') {
+        let upper;
+        if (major > 0n) upper = [major + 1n, 0n, 0n];
+        else if (minor > 0n) upper = [0n, minor + 1n, 0n];
+        else upper = [0n, 0n, patch + 1n];
+        return [{ op: '>=', v }, { op: '<', v: upper }];
+    }
+    if (op === '~') {
+        return [{ op: '>=', v }, { op: '<', v: [major, minor + 1n, 0n] }];
+    }
+    return [{ op, v }];
+}
+
+// Returns a list of alternatives, each a list of { op, v } checks that must
+// all hold. Throws TypeError for anything that isn't a valid range.
+function parseRange(range, cache) {
+    if (typeof range === 'string' && cache.has(range)) return cache.get(range);
+    const invalid = () => new TypeError(`Invalid range: ${JSON.stringify(String(range))}`);
+    if (typeof range !== 'string') throw invalid();
+    const alternatives = range.split('||').map((alt) => {
+        const tokens = alt.trim().split(/\s+/).filter(Boolean);
+        if (tokens.length === 0) throw invalid();
+        return tokens.flatMap((token) => {
+            const checks = parseComparator(token);
+            if (!checks) throw invalid();
+            return checks;
+        });
+    });
+    cache.set(range, alternatives);
+    return alternatives;
+}
+
+function satisfies(version, parsedRange) {
+    return parsedRange.some((checks) =>
+        checks.every(({ op, v }) => TESTS[op](compare(version, v))));
+}
+
+function resolveError(conflict, fallback) {
+    const pkg = conflict ? conflict.pkg : fallback;
+    const detail = conflict ? `: ${conflict.reason}` : '';
+    const err = new Error(`Unable to resolve dependencies for "${pkg}"${detail}`);
+    err.code = 'ERESOLVE';
+    err.package = pkg;
+    return err;
+}
+
+function describe(constraints) {
+    return constraints.map((c) => `${c.range} (from ${c.from})`).join(', ');
+}
+
 export function resolve(registry, root) {
-    throw new Error('not implemented');
+    const rangeCache = new Map();
+    const rootNames = Object.keys(root);
+    const rootParsed = rootNames.map((name) => parseRange(root[name], rangeCache));
+
+    const has = (name) => Object.hasOwn(registry, name)
+        && registry[name] !== null && typeof registry[name] === 'object';
+    for (const name of rootNames) {
+        if (!has(name)) {
+            const err = new Error(`Package "${name}" not found in registry`);
+            err.code = 'ENOTFOUND';
+            err.package = name;
+            throw err;
+        }
+    }
+
+    // Published versions of a package, newest first. Malformed version keys
+    // can never satisfy a range, so they are dropped.
+    const versionCache = new Map();
+    function versionsOf(name) {
+        if (!versionCache.has(name)) {
+            const list = Object.keys(registry[name])
+                .map((str) => ({ str, v: parseVersion(str) }))
+                .filter((entry) => entry.v)
+                .sort((a, b) => compare(b.v, a.v));
+            versionCache.set(name, list);
+        }
+        return versionCache.get(name);
+    }
+
+    // Dependencies of name@version, with ranges parsed. Parsing happens the
+    // first time the resolver considers that version.
+    const depCache = new Map();
+    function depsOf(name, version) {
+        const key = `${name}@${version}`;
+        if (!depCache.has(key)) {
+            const raw = registry[name][version] ?? {};
+            const deps = Object.keys(raw).map((dep) => {
+                const range = raw[dep];
+                try {
+                    return { dep, range, parsed: parseRange(range, rangeCache) };
+                } catch (e) {
+                    throw new TypeError(`${e.message} in dependency "${dep}" of ${key}`);
+                }
+            });
+            depCache.set(key, deps);
+        }
+        return depCache.get(key);
+    }
+
+    // Search state. `order` lists packages in the order first needed; the
+    // first `frames.length` of them have been decided.
+    const order = [...rootNames];
+    const seen = new Set(rootNames);
+    const constraints = new Map(rootNames.map((name, i) => [name, [
+        { range: root[name], parsed: rootParsed[i], from: 'root' },
+    ]]));
+    const selected = new Map();
+    const frames = [];
+    let conflict = null;
+
+    // Tries the frame's remaining candidates in order. On success, records how
+    // to undo the selection and returns true.
+    function advance(frame) {
+        const { name } = frame;
+        while (frame.next < frame.candidates.length) {
+            const { str, v } = frame.candidates[frame.next++];
+            const deps = depsOf(name, str);
+            if (deps.some(({ dep }) => !has(dep))) continue;
+
+            selected.set(name, { str, v });
+            const clash = deps.find(({ dep, parsed }) =>
+                selected.has(dep) && !satisfies(selected.get(dep).v, parsed));
+            if (clash) {
+                conflict = {
+                    pkg: clash.dep,
+                    reason: `${name}@${str} requires ${clash.range}, `
+                        + `but ${clash.dep}@${selected.get(clash.dep).str} is selected`,
+                };
+                selected.delete(name);
+                continue;
+            }
+
+            const from = `${name}@${str}`;
+            for (const { dep, range, parsed } of deps) {
+                if (!constraints.has(dep)) constraints.set(dep, []);
+                constraints.get(dep).push({ range, parsed, from });
+                if (!seen.has(dep)) {
+                    seen.add(dep);
+                    order.push(dep);
+                }
+            }
+            frame.applied = deps;
+            return true;
+        }
+        return false;
+    }
+
+    function undo(frame) {
+        for (const { dep } of frame.applied) {
+            const list = constraints.get(dep);
+            list.pop();
+            if (list.length === 0) constraints.delete(dep);
+        }
+        while (order.length > frame.orderLength) seen.delete(order.pop());
+        selected.delete(frame.name);
+        frame.applied = null;
+    }
+
+    while (frames.length < order.length) {
+        const name = order[frames.length];
+        const known = constraints.get(name);
+        const candidates = versionsOf(name)
+            .filter(({ v }) => known.every(({ parsed }) => satisfies(v, parsed)));
+        if (candidates.length === 0) {
+            conflict = { pkg: name, reason: `no version satisfies ${describe(known)}` };
+        }
+        const frame = { name, candidates, next: 0, applied: null, orderLength: order.length };
+        frames.push(frame);
+
+        // Backtrack until some frame can move on to another candidate.
+        while (!advance(frames[frames.length - 1])) {
+            frames.pop();
+            if (frames.length === 0) throw resolveError(conflict, rootNames[0]);
+            undo(frames[frames.length - 1]);
+        }
+    }
+
+    const result = {};
+    for (const name of order) {
+        Object.defineProperty(result, name, {
+            value: selected.get(name).str,
+            enumerable: true,
+            writable: true,
+            configurable: true,
+        });
+    }
+    return result;
 }
diff --git a/test/resolve.test.js b/test/resolve.test.js
