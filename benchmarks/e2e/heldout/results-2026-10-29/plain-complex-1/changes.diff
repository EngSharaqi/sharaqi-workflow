+
+    test('no solution: ERESOLVE naming a package', () => {
+        const registry = {
+            a: { '1.0.0': { c: '^1.0.0' } },
+            b: { '1.0.0': { c: '^2.0.0' } },
+            c: { '1.0.0': {}, '2.0.0': {} },
+        };
+        const error = expectCode(() => resolve(registry, { a: '*', b: '*' }), 'ERESOLVE');
+        assert.ok(['a', 'b', 'c'].some((name) => error.message.includes(name)), error.message);
+    });
+
+    test('no version matches a root range: ERESOLVE', () => {
+        const error = expectCode(() => resolve({ a: { '1.0.0': {} } }, { a: '^2.0.0' }), 'ERESOLVE');
+        assert.match(error.message, /a/);
+        expectCode(() => resolve({ a: {} }, { a: '*' }), 'ERESOLVE');
+    });
+
+    test('every version needs a missing package: ERESOLVE', () => {
+        const registry = { a: { '1.0.0': { ghost: '*' }, '2.0.0': { ghost: '^1.0.0' } } };
+        const error = expectCode(() => resolve(registry, { a: '*' }), 'ERESOLVE');
+        assert.match(error.message, /a|ghost/);
+    });
+});
+
+// Straightforward recursive statement of the preference rules, used as an
+// oracle on random registries.
+function reference(registry, root) {
+    const cmp = (x, y) => {
+        const a = x.split('.').map(Number);
+        const b = y.split('.').map(Number);
+        return a[0] - b[0] || a[1] - b[1] || a[2] - b[2];
+    };
+    const sat = (v, range) => resolve({ p: { [v]: {} } }, { p: range }) && true;
+    const ok = (v, range) => {
+        try {
+            return sat(v, range);
+        } catch {
+            return false;
+        }
+    };
+    function step(order, ranges, selected) {
+        const i = Object.keys(selected).length;
+        if (i === order.length) return selected;
+        const name = order[i];
+        const versions = Object.keys(registry[name]).sort((x, y) => cmp(y, x))
+            .filter((v) => ranges.filter(([n]) => n === name).every(([, r]) => ok(v, r)));
+        for (const v of versions) {
+            const deps = Object.entries(registry[name][v]);
+            if (deps.some(([d]) => !(d in registry))) continue;
+            const sel = { ...selected, [name]: v };
+            if (deps.some(([d, r]) => d in sel && !ok(sel[d], r))) continue;
+            const nextOrder = [...order];
+            for (const [d] of deps) if (!nextOrder.includes(d)) nextOrder.push(d);
+            const found = step(nextOrder, [...ranges, ...deps], sel);
+            if (found) return found;
+        }
+        return null;
+    }
+    return step(Object.keys(root), Object.entries(root), {});
+}
+
+function randomRegistry(seed) {
+    let s = seed;
+    const rand = (n) => {
+        s = (s * 1103515245 + 12345) % 2147483648;
+        return s % n;
+    };
+    const names = ['a', 'b', 'c', 'd', 'e'];
+    const versions = ['0.1.0', '0.1.5', '1.0.0', '1.2.0', '1.10.0', '2.0.0'];
+    const ranges = ['*', '^1.0.0', '~1.2.0', '<1.2.0', '>=1.2.0', '^0.1.0', '2.0.0',
+        '^0.1.0 || ^2.0.0', '>=1.0.0 <2.0.0', '>1.10.0'];
+    const registry = {};
+    for (const name of names) {
+        registry[name] = {};
+        for (const v of versions) {
+            if (rand(3) === 0) continue;
+            const deps = {};
+            const count = rand(3);
+            for (let k = 0; k < count; k++) {
+                const dep = rand(12) === 0 ? 'ghost' : names[rand(names.length)];
+                deps[dep] = ranges[rand(ranges.length)];
+            }
+            registry[name][v] = deps;
+        }
+    }
+    const root = {};
+    for (const name of names) if (rand(2) === 0) root[name] = ranges[rand(ranges.length)];
+    return { registry, root };
+}
+
+test('matches a reference implementation on random registries', () => {
+    let solved = 0;
+    for (let seed = 1; seed <= 400; seed++) {
+        const { registry, root } = randomRegistry(seed);
+        const expected = reference(registry, root);
+        if (expected) {
+            const actual = resolve(registry, root);
+            assert.deepEqual(actual, expected, `seed ${seed}`);
+            assert.deepEqual(Object.keys(actual), Object.keys(expected), `seed ${seed}`);
+            solved++;
+        } else {
+            expectCode(() => resolve(registry, root), 'ERESOLVE');
+        }
+    }
+    assert.ok(solved > 30, `only ${solved} solvable cases`);
+});
