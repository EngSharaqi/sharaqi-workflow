+        // Excluded by the root range: also never considered.
+        assert.deepEqual(resolve(registry, { a: '^2.0.0' }), { a: '2.0.0' });
+    });
+
+    test('invalid dependency range throws TypeError when its version is considered', () => {
+        const registry = {
+            a: { '2.0.0': { b: '^1.0.0 ||' }, '1.0.0': {} },
