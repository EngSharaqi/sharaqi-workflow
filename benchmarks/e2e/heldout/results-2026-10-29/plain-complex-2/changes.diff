@@ -1,4 +1,201 @@
-// Dependency resolver. Not implemented yet.
+// Dependency resolver.
+//
+// Packages are decided one at a time in the order they are first needed
+// (root entries, then each selected version's dependencies, breadth-first).
+// Each takes the newest version satisfying every range known so far; when a
+// choice leads to a dead end the search backs up chronologically and tries
+// the next older version, so the first complete solution found is returned.
+
+const VERSION_RE = /^(\d+)\.(\d+)\.(\d+)$/;
+const COMPARATOR_RE = /^(=|>=|<=|>|<|\^|~)?(\d+)\.(\d+)\.(\d+)$/;
+
+function parseVersion(str) {
+    const m = VERSION_RE.exec(str);
+    return m ? [Number(m[1]), Number(m[2]), Number(m[3])] : null;
+}
+
+function compare(a, b) {
+    for (let i = 0; i < 3; i++) {
+        if (a[i] !== b[i]) return a[i] < b[i] ? -1 : 1;
+    }
+    return 0;
+}
+
+// Parses one space-free comparator into a list of { op, v } primitives.
+function parseComparator(token) {
+    if (token === '*') return [];
+    const m = COMPARATOR_RE.exec(token);
+    if (!m) return null;
+    const op = m[1] || '=';
+    const v = [Number(m[2]), Number(m[3]), Number(m[4])];
+    const [major, minor, patch] = v;
+    if (op === '^') {
+        let upper;
+        if (major > 0) upper = [major + 1, 0, 0];
+        else if (minor > 0) upper = [0, minor + 1, 0];
+        else upper = [0, 0, patch + 1];
+        return [{ op: '>=', v }, { op: '<', v: upper }];
+    }
+    if (op === '~') {
+        return [{ op: '>=', v }, { op: '<', v: [major, minor + 1, 0] }];
+    }
+    return [{ op, v }];
+}
+
+const rangeCache = new Map();
+
+// Returns a list of alternatives, each a list of primitives that must all
+// hold. Throws a TypeError naming the range if it is malformed.
+function parseRange(range) {
+    if (typeof range === 'string' && rangeCache.has(range)) {
+        return rangeCache.get(range);
+    }
+    const invalid = () => new TypeError(`Invalid range: "${String(range)}"`);
+    if (typeof range !== 'string') throw invalid();
+    const alternatives = [];
+    for (const part of range.split('||')) {
+        const tokens = part.trim().split(/\s+/).filter(Boolean);
+        if (tokens.length === 0) throw invalid();
+        const primitives = [];
+        for (const token of tokens) {
+            const parsed = parseComparator(token);
+            if (!parsed) throw invalid();
+            primitives.push(...parsed);
+        }
+        alternatives.push(primitives);
+    }
+    rangeCache.set(range, alternatives);
+    return alternatives;
+}
+
+function holds(v, { op, v: bound }) {
+    const c = compare(v, bound);
+    switch (op) {
+        case '=': return c === 0;
+        case '>': return c > 0;
+        case '>=': return c >= 0;
+        case '<': return c < 0;
+        case '<=': return c <= 0;
+    }
+    return false;
+}
+
+function satisfies(v, alternatives) {
+    return alternatives.some((prims) => prims.every((p) => holds(v, p)));
+}
+
 export function resolve(registry, root) {
-    throw new Error('not implemented');
+    const rootEntries = Object.entries(root);
+
+    // Root ranges are validated before anything else.
+    for (const [, range] of rootEntries) parseRange(range);
+    for (const [name] of rootEntries) {
+        if (!Object.hasOwn(registry, name)) {
+            const err = new Error(`Package "${name}" not found in registry`);
+            err.code = 'ENOTFOUND';
+            err.package = name;
+            throw err;
+        }
+    }
+
+    // Published versions of each package, newest first.
+    const versionCache = new Map();
+    function versionsOf(name) {
+        let list = versionCache.get(name);
+        if (!list) {
+            list = [];
+            for (const raw of Object.keys(registry[name] ?? {})) {
+                const v = parseVersion(raw);
+                if (v) list.push({ raw, v });
+            }
+            list.sort((a, b) => compare(b.v, a.v));
+            versionCache.set(name, list);
+        }
+        return list;
+    }
+
+    const selected = new Map();    // name -> { raw, v }
+    const constraints = new Map(); // name -> [{ range, parsed, from }]
+    const order = [];              // names in the order first needed
+    let lastConflict = null;
+
+    function addConstraint(name, range, parsed, from) {
+        if (!constraints.has(name)) constraints.set(name, []);
+        constraints.get(name).push({ range, parsed, from });
+        if (constraints.get(name).length === 1) order.push(name);
+    }
+
+    function removeConstraint(name) {
+        const list = constraints.get(name);
+        list.pop();
+        if (list.length === 0) {
+            constraints.delete(name);
+            // A package with no remaining constraints was the last one added.
+            order.pop();
+        }
+    }
+
+    for (const [name, range] of rootEntries) {
+        addConstraint(name, range, parseRange(range), 'root');
+    }
+
+    function step(i) {
+        if (i === order.length) return true;
+        const name = order[i];
+        const known = constraints.get(name);
+        const candidates = versionsOf(name).filter(({ v }) =>
+            known.every((c) => satisfies(v, c.parsed)));
+        if (candidates.length === 0) {
+            const reqs = known.map((c) => `"${c.range}" (from ${c.from})`).join(', ');
+            lastConflict = {
+                name,
+                message: `No version of "${name}" satisfies ${reqs}`,
+            };
+            return false;
+        }
+
+        for (const candidate of candidates) {
+            const from = `${name}@${candidate.raw}`;
+            const deps = Object.entries(registry[name][candidate.raw] ?? {});
+            const parsedDeps = deps.map(([, range]) => parseRange(range));
+
+            const missing = deps.find(([dep]) => !Object.hasOwn(registry, dep));
+            if (missing) {
+                lastConflict = {
+                    name: missing[0],
+                    message: `${from} depends on "${missing[0]}", which is not in the registry`,
+                };
+                continue;
+            }
+
+            selected.set(name, candidate);
+            const clash = deps.findIndex(([dep], k) =>
+                selected.has(dep) && !satisfies(selected.get(dep).v, parsedDeps[k]));
+            if (clash !== -1) {
+                const [dep, range] = deps[clash];
+                lastConflict = {
+                    name: dep,
+                    message: `${from} requires "${dep}" "${range}", but ${dep}@${selected.get(dep).raw} is selected`,
+                };
+                selected.delete(name);
+                continue;
+            }
+
+            deps.forEach(([dep, range], k) => addConstraint(dep, range, parsedDeps[k], from));
+            if (step(i + 1)) return true;
+            for (let k = deps.length - 1; k >= 0; k--) removeConstraint(deps[k][0]);
+            selected.delete(name);
+        }
+        return false;
+    }
+
+    if (!step(0)) {
+        const conflict = lastConflict ?? { name: order[0], message: 'No solution' };
+        const err = new Error(`Unable to resolve dependencies: ${conflict.message}`);
+        err.code = 'ERESOLVE';
+        err.package = conflict.name;
+        throw err;
+    }
+
+    return Object.fromEntries(order.map((name) => [name, selected.get(name).raw]));
 }
