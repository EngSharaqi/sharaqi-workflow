+    });
+
+    test('invalid range on a version reached by backtracking throws', () => {
+        const registry = {
+            a: { '2.0.0': { c: '^2.0.0' }, '1.0.0': { z: '1.2' } },
+            b: { '1.0.0': { c: '^1.0.0' } },
