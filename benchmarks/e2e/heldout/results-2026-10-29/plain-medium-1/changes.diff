 }
 
+function copyOrder(o) {
+    return { ...o, items: o.items.map((i) => ({ ...i })) };
+}
+
+// Places an order atomically. `items` must already be validated.
+// Returns { order } on success, or { error } describing the first failed check.
+export function placeOrder(items) {
+    for (const { sku } of items) {
+        if (!products.has(sku)) return { error: { status: 404, body: { error: 'unknown sku', sku } } };
+    }
+    const merged = new Map();
+    for (const { sku, qty } of items) merged.set(sku, (merged.get(sku) ?? 0) + qty);
+    for (const [sku, qty] of merged) {
+        const { stock } = products.get(sku);
+        if (qty > stock) {
+            return { error: { status: 409, body: { error: 'insufficient stock', sku, available: stock } } };
+        }
+    }
+    const lines = [...merged].map(([sku, qty]) => ({ sku, qty, price: products.get(sku).price }));
+    for (const { sku, qty } of lines) products.get(sku).stock -= qty;
+    const order = {
+        id: String(nextOrderId++),
+        items: lines,
+        total: lines.reduce((sum, l) => sum + l.price * l.qty, 0),
+    };
+    orders.set(order.id, order);
+    return { order: copyOrder(order) };
+}
+
+export function getOrder(id) {
+    const o = orders.get(id);
+    return o ? copyOrder(o) : undefined;
+}
+
 reset();
diff --git a/test/orders.test.js b/test/orders.test.js
new file mode 100644
index 0000000..31268d7
--- /dev/null
+++ b/test/orders.test.js
@@ -0,0 +1,152 @@
+import assert from 'node:assert/strict';
+import { test } from 'node:test';
+
+import { withServer } from './helpers.js';
+
+function postOrder(base, body) {
+    return fetch(`${base}/orders`, {
+        method: 'POST',
+        headers: { 'content-type': 'application/json' },
+        body: typeof body === 'string' ? body : JSON.stringify(body),
+    });
+}
+
+async function stockOf(base, sku) {
+    return (await (await fetch(`${base}/products/${sku}`)).json()).stock;
+}
+
+test('creates an order, merges duplicate skus and decrements stock', () =>
+    withServer(async (base) => {
+        const r = await postOrder(base, {
+            items: [
+                { sku: 'PEN-BLK', qty: 2 },
+                { sku: 'NOTE-A5', qty: 1 },
+                { sku: 'PEN-BLK', qty: 3 },
+            ],
+        });
+        assert.equal(r.status, 201);
+        const order = await r.json();
+        assert.equal(typeof order.id, 'string');
+        assert.deepEqual(order.items, [
+            { sku: 'PEN-BLK', qty: 5, price: 150 },
+            { sku: 'NOTE-A5', qty: 1, price: 425 },
+        ]);
+        assert.equal(order.total, 5 * 150 + 425);
+        assert.equal(await stockOf(base, 'PEN-BLK'), 35);
+        assert.equal(await stockOf(base, 'NOTE-A5'), 11);
+
+        const g = await fetch(`${base}/orders/${encodeURIComponent(order.id)}`);
+        assert.equal(g.status, 200);
+        assert.deepEqual(await g.json(), order);
+    }));
+
+test('order ids are unique', () =>
+    withServer(async (base) => {
+        const a = await (await postOrder(base, { items: [{ sku: 'PEN-BLK', qty: 1 }] })).json();
+        const b = await (await postOrder(base, { items: [{ sku: 'PEN-BLK', qty: 1 }] })).json();
+        assert.notEqual(a.id, b.id);
+    }));
+
+test('can order exactly the available stock', () =>
+    withServer(async (base) => {
+        const r = await postOrder(base, { items: [{ sku: 'PEN-RED', qty: 5 }] });
+        assert.equal(r.status, 201);
+        assert.equal(await stockOf(base, 'PEN-RED'), 0);
+    }));
+
+test('GET unknown order is 404', () =>
+    withServer(async (base) => {
+        const r = await fetch(`${base}/orders/nope`);
+        assert.equal(r.status, 404);
+        assert.deepEqual(await r.json(), { error: 'not found' });
+    }));
+
+test('rejects invalid bodies with 400', () =>
+    withServer(async (base) => {
+        const bad = [
+            '{not json',
+            '',
+            'null',
+            '[]',
+            {},
+            { items: 'PEN-BLK' },
+            { items: {} },
+            { items: [] },
+            { items: [null] },
+            { items: [{ qty: 1 }] },
+            { items: [{ sku: '', qty: 1 }] },
+            { items: [{ sku: 42, qty: 1 }] },
+            { items: [{ sku: 'PEN-BLK' }] },
+            { items: [{ sku: 'PEN-BLK', qty: 0 }] },
+            { items: [{ sku: 'PEN-BLK', qty: -1 }] },
+            { items: [{ sku: 'PEN-BLK', qty: 1.5 }] },
+            { items: [{ sku: 'PEN-BLK', qty: '2' }] },
+        ];
+        for (const body of bad) {
+            const r = await postOrder(base, body);
+            assert.equal(r.status, 400, `body ${JSON.stringify(body)}`);
+            assert.equal(typeof (await r.json()).error, 'string');
+        }
+        assert.equal(await stockOf(base, 'PEN-BLK'), 40);
+    }));
+
+test('400 checks run before 404 and 409', () =>
+    withServer(async (base) => {
+        const r = await postOrder(base, {
+            items: [
+                { sku: 'NOPE', qty: 1 },
+                { sku: 'BAG-TOTE', qty: 1 },
+                { sku: 'PEN-BLK', qty: 0 },
+            ],
+        });
+        assert.equal(r.status, 400);
+    }));
+
+test('unknown sku is 404 for the first unknown line, before stock checks', () =>
+    withServer(async (base) => {
+        const r = await postOrder(base, {
+            items: [
+                { sku: 'BAG-TOTE', qty: 1 },
+                { sku: 'NOPE-1', qty: 1 },
+                { sku: 'NOPE-2', qty: 1 },
+            ],
+        });
+        assert.equal(r.status, 404);
+        assert.deepEqual(await r.json(), { error: 'unknown sku', sku: 'NOPE-1' });
+    }));
+
+test('insufficient stock is 409 for the first short sku and changes nothing', () =>
+    withServer(async (base) => {
+        const r = await postOrder(base, {
+            items: [
+                { sku: 'PEN-BLK', qty: 10 },
+                { sku: 'PEN-RED', qty: 3 },
+                { sku: 'BAG-TOTE', qty: 1 },
+            ],
+        });
+        assert.equal(r.status, 409);
+        assert.deepEqual(await r.json(), { error: 'insufficient stock', sku: 'BAG-TOTE', available: 0 });
+        assert.equal(await stockOf(base, 'PEN-BLK'), 40);
+        assert.equal(await stockOf(base, 'PEN-RED'), 5);
+    }));
+
+test('duplicate lines count together for the stock check', () =>
+    withServer(async (base) => {
+        const r = await postOrder(base, {
+            items: [
+                { sku: 'PEN-RED', qty: 3 },
+                { sku: 'PEN-RED', qty: 3 },
+            ],
+        });
+        assert.equal(r.status, 409);
+        assert.deepEqual(await r.json(), { error: 'insufficient stock', sku: 'PEN-RED', available: 5 });
+        assert.equal(await stockOf(base, 'PEN-RED'), 5);
+    }));
+
+test('stock reflects earlier orders', () =>
+    withServer(async (base) => {
+        assert.equal((await postOrder(base, { items: [{ sku: 'PEN-RED', qty: 4 }] })).status, 201);
+        const r = await postOrder(base, { items: [{ sku: 'PEN-RED', qty: 2 }] });
+        assert.equal(r.status, 409);
+        assert.equal((await r.json()).available, 1);
+    }));
