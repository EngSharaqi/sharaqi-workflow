+// Returns an error message for an invalid order body, or undefined if it is valid.
+function validateOrder(body) {
+    if (body === null || typeof body !== 'object' || Array.isArray(body)) return 'body must be a JSON object';
+    if (!('items' in body)) return 'items is required';
+    if (!Array.isArray(body.items)) return 'items must be an array';
+    if (body.items.length === 0) return 'items must not be empty';
+    for (const [i, line] of body.items.entries()) {
+        if (line === null || typeof line !== 'object' || Array.isArray(line)) return `items[${i}] must be an object`;
+        if (typeof line.sku !== 'string' || line.sku === '') return `items[${i}].sku must be a non-empty string`;
+        if (!Number.isInteger(line.qty) || line.qty <= 0) return `items[${i}].qty must be a positive integer`;
+    }
+    return undefined;
+}
+
+async function createOrder(req, res) {
+    let body;
+    try {
+        body = await readJson(req);
+    } catch {
+        return send(res, 400, { error: 'invalid JSON' });
+    }
+    const invalid = validateOrder(body);
+    if (invalid) return send(res, 400, { error: invalid });
+    const result = placeOrder(body.items.map(({ sku, qty }) => ({ sku, qty })));
+    if (result.error) return send(res, result.error.status, result.error.body);
+    return send(res, 201, result.order);
+}
 
