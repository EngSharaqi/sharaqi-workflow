+// Returns an error message for a malformed order body, or undefined if valid.
+function validateOrder(body) {
+    if (body === null || typeof body !== 'object' || Array.isArray(body)) return 'body must be an object';
+    const { items } = body;
+    if (items === undefined) return 'items is required';
+    if (!Array.isArray(items)) return 'items must be an array';
+    if (items.length === 0) return 'items must not be empty';
+    for (const line of items) {
+        if (line === null || typeof line !== 'object' || Array.isArray(line)) return 'each item must be an object';
+        if (typeof line.sku !== 'string' || line.sku === '') return 'sku must be a non-empty string';
+        if (!Number.isInteger(line.qty) || line.qty <= 0) return 'qty must be a positive integer';
+    }
+    return undefined;
+}
+
+async function postOrder(req, res) {
+    let body;
+    try {
+        body = await readJson(req);
+    } catch {
+        return send(res, 400, { error: 'invalid JSON' });
+    }
+    const invalid = validateOrder(body);
+    if (invalid) return send(res, 400, { error: invalid });
+    const { error, order } = createOrder(body.items.map(({ sku, qty }) => ({ sku, qty })));
+    return error ? send(res, error.status, error.body) : send(res, 201, order);
+}
 
