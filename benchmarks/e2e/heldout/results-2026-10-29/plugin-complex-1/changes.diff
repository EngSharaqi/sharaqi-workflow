--- a/src/resolve.js
+++ b/src/resolve.js
@@ -1,4 +1,250 @@
-// Dependency resolver. Not implemented yet.
+// Dependency resolver: picks one version per needed package so that every
+// range from the root and from every selected version holds.
+//
+// Packages are resolved breadth-first in first-needed order, each taking the
+// newest version allowed by the ranges known so far. Conflicts back up to the
+// previous decision and try its next older candidate. The search is iterative
+// (explicit stack plus undo log), so deep graphs cannot overflow the call stack.
+
+const NUM = '(0|[1-9]\\d*)';
+const VERSION_RE = new RegExp(`^${NUM}\\.${NUM}\\.${NUM}$`);
+const COMPARATOR_RE = new RegExp(`^(>=|<=|>|<|=|\\^|~)?${NUM}\\.${NUM}\\.${NUM}$`);
+
+const hasOwn = (obj, key) => obj !== null && typeof obj === 'object' && Object.hasOwn(obj, key);
+
+function parseVersion(text) {
+    const m = VERSION_RE.exec(text);
+    const v = m ? [Number(m[1]), Number(m[2]), Number(m[3])] : null;
+    return v && v.every(Number.isSafeInteger) ? v : null;
+}
+
+function compare(a, b) {
+    return a[0] - b[0] || a[1] - b[1] || a[2] - b[2];
+}
+
+// A comparator becomes a list of [op, version] bounds that must all hold.
+function comparatorBounds(text, range) {
+    if (text === '*') {
+        return [];
+    }
+    const m = COMPARATOR_RE.exec(text);
+    if (!m) {
+        throw new TypeError(`Invalid range: "${range}"`);
+    }
+    const op = m[1] ?? '=';
+    const v = [Number(m[2]), Number(m[3]), Number(m[4])];
+    if (!v.every(Number.isSafeInteger)) {
+        throw new TypeError(`Invalid range: "${range}"`);
+    }
+    switch (op) {
+        case '^': {
+            let upper;
+            if (v[0] > 0) {
+                upper = [v[0] + 1, 0, 0];
+            } else if (v[1] > 0) {
+                upper = [0, v[1] + 1, 0];
+            } else {
+                upper = [0, 0, v[2] + 1];
+            }
+            return [['>=', v], ['<', upper]];
+        }
+        case '~':
+            return [['>=', v], ['<', [v[0], v[1] + 1, 0]]];
+        default:
+            return [[op, v]];
+    }
+}
+
+const rangeCache = new Map();
+
+// Returns an array of alternatives; each alternative is a list of bounds.
+function parseRange(range) {
+    if (typeof range !== 'string') {
+        throw new TypeError(`Invalid range: "${String(range)}"`);
+    }
+    if (rangeCache.has(range)) {
+        return rangeCache.get(range);
+    }
+    const alternatives = range.split('||').map((alt) => {
+        const trimmed = alt.trim();
+        if (trimmed === '') {
+            throw new TypeError(`Invalid range: "${range}"`);
+        }
+        return trimmed.split(/\s+/).flatMap((c) => comparatorBounds(c, range));
+    });
+    if (rangeCache.size >= 1000) {
+        rangeCache.clear();
+    }
+    rangeCache.set(range, alternatives);
+    return alternatives;
+}
+
+function holds([op, bound], v) {
+    const c = compare(v, bound);
+    switch (op) {
+        case '=': return c === 0;
+        case '>': return c > 0;
+        case '>=': return c >= 0;
+        case '<': return c < 0;
+        case '<=': return c <= 0;
+        default: return false;
+    }
+}
+
+function satisfies(parsed, v) {
+    return parsed.some((alt) => alt.every((b) => holds(b, v)));
+}
+
+function resolveError(name) {
+    const err = new Error(`Unable to resolve a version of "${name}" that satisfies all ranges`);
+    err.code = 'ERESOLVE';
+    err.package = name;
+    return err;
+}
+
 export function resolve(registry, root) {
-    throw new Error('not implemented');
+    const rootNames = Object.keys(root);
+
+    // Root ranges are validated before anything else, including ENOTFOUND.
+    const rootParsed = rootNames.map((name) => parseRange(root[name]));
+    for (const name of rootNames) {
+        if (!hasOwn(registry, name)) {
+            const err = new Error(`Package "${name}" not found in registry`);
+            err.code = 'ENOTFOUND';
+            err.package = name;
+            throw err;
+        }
+    }
+
+    // Sorted (newest first) valid versions per package, computed lazily.
+    const versionCache = new Map();
+    const versionsOf = (name) => {
+        if (!versionCache.has(name)) {
+            const list = [];
+            for (const text of Object.keys(registry[name] ?? {})) {
+                const v = parseVersion(text);
+                if (v) {
+                    list.push({ text, v });
+                }
+            }
+            list.sort((a, b) => compare(b.v, a.v));
+            versionCache.set(name, list);
+        }
+        return versionCache.get(name);
+    };
+
+    const ranges = new Map(); // name -> parsed ranges known so far
+    const selected = new Map(); // name -> { text, v }
+    const queue = [];
+    const queued = new Set();
+    const log = []; // names whose range list got one entry appended
+
+    const addRange = (name, parsed) => {
+        if (!ranges.has(name)) {
+            ranges.set(name, []);
+        }
+        ranges.get(name).push(parsed);
+        log.push(name);
+    };
+    const enqueue = (name) => {
+        if (!queued.has(name)) {
+            queued.add(name);
+            queue.push(name);
+        }
+    };
+
+    rootNames.forEach((name, i) => {
+        addRange(name, rootParsed[i]);
+        enqueue(name);
+    });
+
+    // Undo everything done after a frame was opened.
+    const rewind = (frame) => {
+        selected.delete(frame.name);
+        while (log.length > frame.logMark) {
+            ranges.get(log.pop()).pop();
+        }
+        while (queue.length > frame.queueLen) {
+            queued.delete(queue.pop());
+        }
+    };
+
+    // Try to take `cand` for `name`; returns false if it cannot be selected.
+    const tryCandidate = (name, cand) => {
+        const deps = registry[name][cand.text];
+        const depNames = deps !== null && typeof deps === 'object' ? Object.keys(deps) : [];
+        // Validate every dependency range first: invalid ranges are fatal.
+        const parsed = depNames.map((dep) => parseRange(deps[dep]));
+        for (let i = 0; i < depNames.length; i++) {
+            const dep = depNames[i];
+            if (!hasOwn(registry, dep)) {
+                return false;
+            }
+            const current = dep === name ? cand : selected.get(dep);
+            if (current && !satisfies(parsed[i], current.v)) {
+                return false;
+            }
+        }
+        selected.set(name, cand);
+        depNames.forEach((dep, i) => {
+            addRange(dep, parsed[i]);
+            enqueue(dep);
+        });
+        return true;
+    };
+
+    const stack = [];
+    let deepest = null; // { depth, name } of the deepest exhausted decision
+    let pos = 0;
+
+    for (;;) {
+        if (pos === queue.length) {
+            const result = {};
+            for (const name of queue) {
+                Object.defineProperty(result, name, {
+                    value: selected.get(name).text,
+                    enumerable: true,
+                    writable: true,
+                    configurable: true,
+                });
+            }
+            return result;
+        }
+
+        const name = queue[pos];
+        const known = ranges.get(name) ?? [];
+        stack.push({
+            name,
+            pos,
+            candidates: versionsOf(name).filter((c) => known.every((r) => satisfies(r, c.v))),
+            next: 0,
+            logMark: log.length,
+            queueLen: queue.length,
+        });
+
+        // Advance the top frame to its next workable candidate, backing up as needed.
+        for (;;) {
+            const frame = stack.at(-1);
+            if (!frame) {
+                throw resolveError(deepest.name);
+            }
+            rewind(frame);
+            let taken = false;
+            while (frame.next < frame.candidates.length) {
+                const cand = frame.candidates[frame.next++];
+                if (tryCandidate(frame.name, cand)) {
+                    taken = true;
+                    break;
+                }
+            }
+            if (taken) {
+                pos = frame.pos + 1;
+                break;
+            }
+            if (!deepest || stack.length > deepest.depth) {
+                deepest = { depth: stack.length, name: frame.name };
+            }
+            stack.pop();
+        }
+    }
 }
diff --git a/test/resolve.test.js b/test/resolve.test.js
