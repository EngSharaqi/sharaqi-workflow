-// Dependency resolver. Not implemented yet.
+// Dependency resolver: depth-first search over a breadth-first queue of
+// packages, newest version first, backtracking on dead ends.
+
+const VERSION_RE = /^(\d+)\.(\d+)\.(\d+)$/;
+const COMPARATOR_RE = /^(>=|<=|>|<|=|\^|~)?(\d+)\.(\d+)\.(\d+)$/;
+
+function compareParts(a, b) {
+    for (let i = 0; i < 3; i++) {
+        if (a[i] !== b[i]) {
+            return a[i] < b[i] ? -1 : 1;
+        }
+    }
+    return 0;
+}
+
+function parseVersion(text) {
+    const m = VERSION_RE.exec(text);
+    if (!m) {
+        return null;
+    }
+    return [Number(m[1]), Number(m[2]), Number(m[3])];
+}
+
+// A comparator is a predicate on version parts; a range is a list of
+// alternatives, each a list of comparators that must all hold.
+function parseComparator(token) {
+    if (token === '*') {
+        return () => true;
+    }
+    const m = COMPARATOR_RE.exec(token);
+    if (!m) {
+        return null;
+    }
+    const op = m[1] ?? '=';
+    const v = [Number(m[2]), Number(m[3]), Number(m[4])];
+    switch (op) {
+        case '=':
+            return (x) => compareParts(x, v) === 0;
+        case '>':
+            return (x) => compareParts(x, v) > 0;
+        case '>=':
+            return (x) => compareParts(x, v) >= 0;
+        case '<':
+            return (x) => compareParts(x, v) < 0;
+        case '<=':
+            return (x) => compareParts(x, v) <= 0;
+        case '~': {
+            const upper = [v[0], v[1] + 1, 0];
+            return (x) => compareParts(x, v) >= 0 && compareParts(x, upper) < 0;
+        }
+        case '^': {
+            let upper;
+            if (v[0] > 0) {
+                upper = [v[0] + 1, 0, 0];
+            } else if (v[1] > 0) {
+                upper = [0, v[1] + 1, 0];
+            } else {
+                upper = [0, 0, v[2] + 1];
+            }
+            return (x) => compareParts(x, v) >= 0 && compareParts(x, upper) < 0;
+        }
+        default:
+            return null;
+    }
+}
+
+function parseRange(range) {
+    const invalid = () => new TypeError(`Invalid range: ${JSON.stringify(String(range))}`);
+    if (typeof range !== 'string') {
+        throw invalid();
+    }
+    const alternatives = [];
+    for (const part of range.split('||')) {
+        const trimmed = part.trim();
+        if (trimmed === '') {
+            throw invalid();
+        }
+        const comparators = [];
+        for (const token of trimmed.split(/\s+/)) {
+            const comparator = parseComparator(token);
+            if (!comparator) {
+                throw invalid();
+            }
+            comparators.push(comparator);
+        }
+        alternatives.push(comparators);
+    }
+    const test = (parts) => alternatives.some((alt) => alt.every((c) => c(parts)));
+    return test;
+}
+
+function resolveError(name, constraints) {
+    const list = (constraints.get(name) ?? []).map((c) => `${c.range} (from ${c.from})`);
+    const detail = list.length ? `: no version satisfies ${list.join(', ')}` : '';
+    const err = new Error(`Unable to resolve package "${name}"${detail}`);
+    err.code = 'ERESOLVE';
+    err.package = name;
+    return err;
+}
+
 export function resolve(registry, root) {
-    throw new Error('not implemented');
+    const rootNames = Object.keys(root ?? {});
+
+    // Root ranges are validated before anything else.
+    const rootTests = rootNames.map((name) => parseRange(root[name]));
+
+    for (const name of rootNames) {
+        if (!Object.hasOwn(registry, name)) {
+            const err = new Error(`Package "${name}" not found in registry`);
+            err.code = 'ENOTFOUND';
+            err.package = name;
+            throw err;
+        }
+    }
+
+    // name -> versions sorted newest first: [{ key, parts }]
+    const versionCache = new Map();
+    const versionsOf = (name) => {
+        let list = versionCache.get(name);
+        if (!list) {
+            list = [];
+            for (const key of Object.keys(registry[name] ?? {})) {
+                const parts = parseVersion(key);
+                if (parts) {
+                    list.push({ key, parts });
+                }
+            }
+            list.sort((a, b) => compareParts(b.parts, a.parts));
+            versionCache.set(name, list);
+        }
+        return list;
+    };
+
+    const selected = new Map(); // name -> { key, parts }
+    const constraints = new Map(); // name -> [{ range, test, from }]
+    const queue = [];
+    const inQueue = new Set();
+
+    const addConstraint = (name, range, test, from) => {
+        let list = constraints.get(name);
+        if (!list) {
+            list = [];
+            constraints.set(name, list);
+        }
+        list.push({ range, test, from });
+    };
+
+    rootNames.forEach((name, i) => {
+        addConstraint(name, root[name], rootTests[i], 'root');
+        if (!inQueue.has(name)) {
+            inQueue.add(name);
+            queue.push(name);
+        }
+    });
+
+    const satisfiesAll = (name, parts) =>
+        (constraints.get(name) ?? []).every((c) => c.test(parts));
+
+    let conflict = rootNames[0];
+
+    // Try to select `version` of `name`. Returns an undo record on success,
+    // null if the version cannot be selected in the current state.
+    const tryApply = (name, version) => {
+        const deps = registry[name][version.key] ?? {};
+        const depNames = Object.keys(deps);
+        // Validate every dependency range of this version first.
+        const depTests = depNames.map((dep) => parseRange(deps[dep]));
+
+        selected.set(name, version);
+        for (let i = 0; i < depNames.length; i++) {
+            const dep = depNames[i];
+            if (!Object.hasOwn(registry, dep)) {
+                selected.delete(name);
+                return null;
+            }
+            const chosen = selected.get(dep);
+            if (chosen && !depTests[i](chosen.parts)) {
+                conflict = dep;
+                selected.delete(name);
+                return null;
+            }
+        }
+
+        const from = `${name}@${version.key}`;
+        const queueLength = queue.length;
+        for (let i = 0; i < depNames.length; i++) {
+            const dep = depNames[i];
+            addConstraint(dep, deps[dep], depTests[i], from);
+            if (!inQueue.has(dep)) {
+                inQueue.add(dep);
+                queue.push(dep);
+            }
+        }
+        return { name, depNames, queueLength };
+    };
+
+    const undo = (record) => {
+        for (const dep of record.depNames) {
+            const list = constraints.get(dep);
+            list.pop();
+            if (list.length === 0) {
+                constraints.delete(dep);
+            }
+        }
+        while (queue.length > record.queueLength) {
+            inQueue.delete(queue.pop());
+        }
+        selected.delete(record.name);
+    };
+
+    // stack[k] decides queue[k].
+    const stack = [];
+    for (;;) {
+        if (stack.length === queue.length) {
+            const result = {};
+            for (const name of queue) {
+                Object.defineProperty(result, name, {
+                    value: selected.get(name).key,
+                    enumerable: true,
+                    writable: true,
+                    configurable: true,
+                });
+            }
+            return result;
+        }
+
+        const name = queue[stack.length];
+        const candidates = versionsOf(name).filter((v) => satisfiesAll(name, v.parts));
+        if (candidates.length === 0) {
+            conflict = name;
+        }
+        stack.push({ name, candidates, index: 0, record: null });
+
+        let advanced = false;
+        while (stack.length > 0) {
+            const frame = stack[stack.length - 1];
+            if (frame.record) {
+                undo(frame.record);
+                frame.record = null;
+            }
+            while (frame.index < frame.candidates.length) {
+                const record = tryApply(frame.name, frame.candidates[frame.index++]);
+                if (record) {
+                    frame.record = record;
+                    advanced = true;
+                    break;
+                }
+            }
+            if (advanced) {
+                break;
+            }
+            stack.pop();
+        }
+        if (!advanced) {
+            throw resolveError(conflict ?? 'root', constraints);
+        }
+    }
 }
diff --git a/test/resolve.test.js b/test/resolve.test.js
