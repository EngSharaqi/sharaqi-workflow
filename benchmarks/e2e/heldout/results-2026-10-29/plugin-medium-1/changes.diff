 }
 
 export function listProducts() {
@@ -21,4 +25,33 @@ export function getProduct(sku) {
     return p ? { ...p } : undefined;
 }
 
+// Lines are already validated. Merges by sku, checks 404 then 409, and only then touches stock.
+export function placeOrder(lines) {
+    const qtyBySku = new Map();
+    for (const { sku, qty } of lines) qtyBySku.set(sku, (qtyBySku.get(sku) ?? 0) + qty);
+    for (const sku of qtyBySku.keys()) {
+        if (!products.has(sku)) return { error: 'unknown sku', status: 404, sku };
+    }
+    for (const [sku, qty] of qtyBySku) {
+        const available = products.get(sku).stock;
+        if (qty > available) return { error: 'insufficient stock', status: 409, sku, available };
+    }
+    const items = [];
+    let total = 0;
+    for (const [sku, qty] of qtyBySku) {
+        const p = products.get(sku);
+        p.stock -= qty;
+        items.push({ sku, qty, price: p.price });
+        total += p.price * qty;
+    }
+    const order = { id: randomUUID(), items, total };
+    orders.set(order.id, order);
+    return { order: structuredClone(order) };
+}
+
+export function getOrder(id) {
+    const o = orders.get(id);
+    return o ? structuredClone(o) : undefined;
+}
+
 reset();
diff --git a/test/orders.test.js b/test/orders.test.js
new file mode 100644
index 0000000..32fa38c
--- /dev/null
+++ b/test/orders.test.js
@@ -0,0 +1,92 @@
+import assert from 'node:assert/strict';
+import { test } from 'node:test';
+
+import { withServer } from './helpers.js';
+
+const post = (base, body, raw) =>
+    fetch(`${base}/orders`, {
+        method: 'POST',
+        headers: { 'content-type': 'application/json' },
+        body: raw ?? JSON.stringify(body),
+    });
+const stock = async (base, sku) => (await (await fetch(`${base}/products/${sku}`)).json()).stock;
+
+test('400 for malformed bodies', () =>
+    withServer(async (base) => {
+        const bad = [
+            [undefined, '{nope'],
+            [undefined, ''],
+            [null],
+            [[]],
+            [{}],
+            [{ items: 'x' }],
+            [{ items: [] }],
+            [{ items: [null] }],
+            [{ items: [{ qty: 1 }] }],
+            [{ items: [{ sku: '', qty: 1 }] }],
+            [{ items: [{ sku: 5, qty: 1 }] }],
+            [{ items: [{ sku: 'PEN-BLK' }] }],
+            [{ items: [{ sku: 'PEN-BLK', qty: 0 }] }],
+            [{ items: [{ sku: 'PEN-BLK', qty: -1 }] }],
+            [{ items: [{ sku: 'PEN-BLK', qty: 1.5 }] }],
+            [{ items: [{ sku: 'PEN-BLK', qty: '2' }] }],
+        ];
+        for (const [body, raw] of bad) {
+            const r = await post(base, body, raw);
+            assert.equal(r.status, 400, JSON.stringify(body ?? raw));
+            assert.equal(typeof (await r.json()).error, 'string');
+        }
+    }));
+
+test('400 beats 404 and 404 beats 409', () =>
+    withServer(async (base) => {
+        let r = await post(base, { items: [{ sku: 'NOPE', qty: 1 }, { sku: 'PEN-BLK', qty: 0 }] });
+        assert.equal(r.status, 400);
+        r = await post(base, { items: [{ sku: 'BAG-TOTE', qty: 1 }, { sku: 'NOPE', qty: 1 }] });
+        assert.equal(r.status, 404);
+        assert.deepEqual(await r.json(), { error: 'unknown sku', sku: 'NOPE' });
+    }));
+
+test('409 reports first short sku, counts duplicates together, changes nothing', () =>
+    withServer(async (base) => {
+        const r = await post(base, {
+            items: [{ sku: 'PEN-BLK', qty: 1 }, { sku: 'PEN-RED', qty: 3 }, { sku: 'PEN-RED', qty: 3 }],
+        });
+        assert.equal(r.status, 409);
+        assert.deepEqual(await r.json(), { error: 'insufficient stock', sku: 'PEN-RED', available: 5 });
+        assert.equal(await stock(base, 'PEN-BLK'), 40);
+        assert.equal(await stock(base, 'PEN-RED'), 5);
+    }));
+
+test('201 merges lines, totals, decrements stock, and is fetchable', () =>
+    withServer(async (base) => {
+        const r = await post(base, {
+            items: [{ sku: 'NOTE-A5', qty: 1 }, { sku: 'PEN-BLK', qty: 2 }, { sku: 'NOTE-A5', qty: 2 }],
+        });
+        assert.equal(r.status, 201);
+        const order = await r.json();
+        assert.equal(typeof order.id, 'string');
+        assert.deepEqual(order.items, [
+            { sku: 'NOTE-A5', qty: 3, price: 425 },
+            { sku: 'PEN-BLK', qty: 2, price: 150 },
+        ]);
+        assert.equal(order.total, 3 * 425 + 2 * 150);
+        assert.equal(await stock(base, 'NOTE-A5'), 9);
+        assert.equal(await stock(base, 'PEN-BLK'), 38);
+        const g = await fetch(`${base}/orders/${order.id}`);
+        assert.equal(g.status, 200);
+        assert.deepEqual(await g.json(), order);
+    }));
+
+test('can buy exactly the remaining stock', () =>
+    withServer(async (base) => {
+        assert.equal((await post(base, { items: [{ sku: 'PEN-RED', qty: 5 }] })).status, 201);
+        assert.equal(await stock(base, 'PEN-RED'), 0);
+    }));
+
+test('GET unknown order is 404', () =>
+    withServer(async (base) => {
+        const r = await fetch(`${base}/orders/nope`);
+        assert.equal(r.status, 404);
+        assert.deepEqual(await r.json(), { error: 'not found' });
+    }));
