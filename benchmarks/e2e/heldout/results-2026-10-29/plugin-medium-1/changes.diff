 // In-memory catalogue. Prices are integer cents.
 const SEED = [
     { sku: 'PEN-BLK', name: 'Black pen', price: 150, stock: 40 },
@@ -7,9 +9,11 @@ const SEED = [
 ];
 
 let products = new Map();
+let orders = new Map();
 
 export function reset() {
     products = new Map(SEED.map((p) => [p.sku, { ...p }]));
