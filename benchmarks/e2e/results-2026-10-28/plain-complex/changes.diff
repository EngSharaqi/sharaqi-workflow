+        this.#invalidate(id);
     }
 
     get(ref) {
-        throw new Error('not implemented');
+        const id = refToId(ref);
+        const cell = this.cells.get(id);
+        if (!cell) return null;
+        let v = cell.kind === 'const' ? cell.value : this.#compute(id);
+        if (cell.kind === 'formula' && v === null) v = 0;
+        if (v instanceof CellError) return v.code;
+        if (Object.is(v, -0)) return 0;
+        return v;
+    }
+
+    #register(id) {
+        const cell = this.cells.get(id);
+        this.formulaIds.add(id);
+        for (const r of cell.refs) {
+            let s = this.refBy.get(r);
+            if (!s) this.refBy.set(r, (s = new Set()));
+            s.add(id);
+        }
+        if (cell.ranges.length) this.rangeFormulas.set(id, cell.ranges);
+    }
+
+    #unregister(id) {
+        const cell = this.cells.get(id);
+        if (!cell) return;
+        this.cells.delete(id);
+        if (cell.kind !== 'formula') return;
+        this.formulaIds.delete(id);
+        for (const r of cell.refs) {
+            const s = this.refBy.get(r);
+            s.delete(id);
+            if (s.size === 0) this.refBy.delete(r);
+        }
+        this.rangeFormulas.delete(id);
+    }
+
+    // Drop the cached value of `id` and of every cached formula that depends on
+    // it, transitively. Uncached formulas need no walk: by the cache invariant
+    // nothing cached depends on them.
+    #invalidate(id) {
+        this.cache.delete(id);
+        const work = [id];
+        while (work.length) {
+            const cur = work.pop();
+            const visit = (dep) => {
+                if (this.cache.has(dep)) {
+                    this.cache.delete(dep);
+                    work.push(dep);
+                }
+            };
+            const direct = this.refBy.get(cur);
+            if (direct) for (const dep of direct) visit(dep);
+            for (const [dep, ranges] of this.rangeFormulas) {
+                if (ranges.some((box) => boxContains(box, cur))) visit(dep);
+            }
+        }
+    }
+
+    // Ids of non-empty cells inside `box`, in row-major order.
+    #cellsInBox(box, pool) {
+        const out = [];
+        const area = (box.c2 - box.c1 + 1) * (box.r2 - box.r1 + 1);
+        if (area <= pool.size) {
+            for (let r = box.r1; r <= box.r2; r++) {
+                for (let c = box.c1; c <= box.c2; c++) {
+                    const id = idOf(c, r);
+                    if (pool.has(id)) out.push(id);
+                }
+            }
+        } else {
+            for (const id of pool.keys()) if (boxContains(box, id)) out.push(id);
+            out.sort((x, y) => x - y);
+        }
+        return out;
+    }
+
+    // Formula cells referenced by `id` whose value is not cached yet.
+    #pendingDeps(id) {
+        const cell = this.cells.get(id);
+        const out = [];
+        for (const r of cell.refs) {
+            if (this.formulaIds.has(r) && !this.cache.has(r)) out.push(r);
+        }
+        for (const box of cell.ranges) {
+            for (const r of this.#cellsInBox(box, this.formulaIds)) {
+                if (!this.cache.has(r)) out.push(r);
+            }
+        }
+        return out;
     }
+
+    // Iterative Tarjan SCC from `start`, resolving each SCC as it is emitted.
+    #compute(start) {
+        if (this.cache.has(start)) return this.cache.get(start);
+
+        const index = new Map();
+        const low = new Map();
+        const stack = [];
+        const onStack = new Set();
+        const frames = [];
+        let counter = 0;
+
+        const enter = (v) => {
+            index.set(v, counter);
+            low.set(v, counter);
+            counter++;
+            stack.push(v);
+            onStack.add(v);
+            frames.push({ v, deps: this.#pendingDeps(v), i: 0 });
+        };
+
+        enter(start);
+        while (frames.length) {
+            const frame = frames[frames.length - 1];
+            if (frame.i < frame.deps.length) {
+                const w = frame.deps[frame.i++];
+                if (!index.has(w)) enter(w);
+                else if (onStack.has(w)) low.set(frame.v, Math.min(low.get(frame.v), index.get(w)));
+                continue;
+            }
+            frames.pop();
+            const v = frame.v;
+            if (frames.length) {
+                const parent = frames[frames.length - 1].v;
+                low.set(parent, Math.min(low.get(parent), low.get(v)));
+            }
+            if (low.get(v) !== index.get(v)) continue;
+
+            const scc = [];
+            let w;
+            do {
+                w = stack.pop();
+                onStack.delete(w);
+                scc.push(w);
+            } while (w !== v);
+
+            if (scc.length > 1 || frame.deps.includes(v)) {
+                for (const c of scc) this.cache.set(c, CYCLE);
+            } else {
+                this.cache.set(v, this.#eval(this.cells.get(v).ast));
+            }
+        }
+        return this.cache.get(start);
+    }
+
+    // Value of a cell as seen by a formula: number, string, CellError or null (empty).
+    #valueOf(id) {
+        const cell = this.cells.get(id);
+        if (!cell) return null;
+        return cell.kind === 'const' ? cell.value : this.cache.get(id);
+    }
+
+    #eval(node) {
+        switch (node.t) {
+            case 'num':
+                return node.v;
+            case 'ref':
+                return node.id === null ? REF : this.#valueOf(node.id);
+            case 'range':
+                return node.box === null ? REF : VALUE;
+            case 'neg': {
+                const a = toNumber(this.#eval(node.a));
+                return a instanceof CellError ? a : -a;
+            }
+            case 'bin':
+                return this.#evalBinary(node);
+            case 'fn':
+                return this.#evalCall(node);
+        }
+        throw new Error(`unknown node ${node.t}`);
+    }
+
+    #evalBinary(node) {
+        const ra = this.#eval(node.a);
+        if (ra instanceof CellError) return ra;
+        const rb = this.#eval(node.b);
+        if (rb instanceof CellError) return rb;
+        const a = toNumber(ra);
+        if (a instanceof CellError) return a;
+        const b = toNumber(rb);
+        if (b instanceof CellError) return b;
+        switch (node.op) {
+            case '+': return a + b;
+            case '-': return a - b;
+            case '*': return a * b;
+            case '/': return b === 0 ? DIV0 : a / b;
+            case '=': return a === b ? 1 : 0;
+            case '<>': return a !== b ? 1 : 0;
+            case '<': return a < b ? 1 : 0;
+            case '>': return a > b ? 1 : 0;
+            case '<=': return a <= b ? 1 : 0;
+            case '>=': return a >= b ? 1 : 0;
+        }
+        throw new Error(`unknown operator ${node.op}`);
+    }
+
+    #evalCall(node) {
+        if (!KNOWN_FNS.has(node.name)) return NAME;
+        if (node.name === 'IF') {
+            const cond = toNumber(this.#eval(node.args[0]));
+            if (cond instanceof CellError) return cond;
+            return this.#eval(cond !== 0 ? node.args[1] : node.args[2]);
+        }
+
+        // Collect numbers left to right; text and empty values are ignored.
+        const nums = [];
+        for (const arg of node.args) {
+            if (arg.t === 'range') {
+                if (arg.box === null) return REF;
+                for (const id of this.#cellsInBox(arg.box, this.cells)) {
+                    const v = this.#valueOf(id);
+                    if (v instanceof CellError) return v;
+                    if (typeof v === 'number') nums.push(v);
+                }
+            } else {
+                const v = this.#eval(arg);
+                if (v instanceof CellError) return v;
+                if (typeof v === 'number') nums.push(v);
+            }
+        }
+        switch (node.name) {
+            case 'SUM': return nums.reduce((s, x) => s + x, 0);
+            case 'COUNT': return nums.length;
+            case 'MIN': return nums.length ? nums.reduce((m, x) => Math.min(m, x)) : 0;
+            case 'MAX': return nums.length ? nums.reduce((m, x) => Math.max(m, x)) : 0;
+        }
+        throw new Error(`unknown function ${node.name}`);
+    }
+}
+
+// Operand coercion for operators, comparisons and IF conditions.
+function toNumber(v) {
+    if (v === null) return 0;
+    if (typeof v === 'string') return VALUE;
+    return v;
 }
