@@ -0,0 +1,255 @@
+import assert from 'node:assert/strict';
+import { describe, test } from 'node:test';
+
+import { Sheet } from '../src/sheet.js';
+
+function sheet(cells) {
+    const s = new Sheet();
+    for (const [ref, raw] of Object.entries(cells)) s.set(ref, raw);
+    return s;
+}
+
+function evalFormula(formula, cells = {}) {
+    const s = sheet(cells);
+    s.set('Z99999', formula);
+    return s.get('Z99999');
+}
+
+describe('references', () => {
+    test('are case-insensitive', () => {
+        const s = new Sheet();
+        s.set('a1', '5');
+        assert.equal(s.get('A1'), 5);
+        assert.equal(evalFormula('=a1*2', { A1: '4' }), 8);
+    });
+
+    test('invalid references throw RangeError', () => {
+        const s = new Sheet();
+        for (const ref of ['A0', 'AA1', 'A100000', '1A', '', 'A', 'A1.5', ' A1', undefined]) {
+            assert.throws(() => s.get(ref), RangeError, String(ref));
+            assert.throws(() => s.set(ref, '1'), RangeError, String(ref));
+        }
+        assert.equal(s.get('Z99999'), null);
+    });
+});
+
+describe('raw input', () => {
+    test('numbers, text, empty', () => {
+        const s = new Sheet();
+        s.set('A1', ' 3 ');
+        s.set('A2', '-2.5');
+        s.set('A3', '1e3');
+        s.set('A4', ' hello ');
+        s.set('A5', '   ');
+        s.set('A6', 'Infinity');
+        assert.equal(s.get('A1'), 3);
+        assert.equal(s.get('A2'), -2.5);
+        assert.equal(s.get('A3'), 1000);
+        assert.equal(s.get('A4'), ' hello ');
+        assert.equal(s.get('A5'), '   ');
+        assert.equal(s.get('A6'), 'Infinity');
+        assert.equal(s.get('A7'), null);
+        s.set('A1', '');
+        assert.equal(s.get('A1'), null);
+    });
+
+    test('text that looks like an error is still text', () => {
+        assert.equal(evalFormula('=A1', { A1: '#DIV/0!' }), '#DIV/0!');
+        assert.equal(evalFormula('=A1+1', { A1: '#DIV/0!' }), '#VALUE!');
+    });
+});
+
+describe('formulas', () => {
+    test('arithmetic and precedence', () => {
+        assert.equal(evalFormula('=1+2*3'), 7);
+        assert.equal(evalFormula('=(1+2)*3'), 9);
+        assert.equal(evalFormula('=10-4-3'), 3);
+        assert.equal(evalFormula('=24/4/2'), 3);
+        assert.equal(evalFormula('=-2*-3'), 6);
+        assert.equal(evalFormula('=--2'), 2);
+        assert.equal(evalFormula('= 3.5 + 0.5 '), 4);
+        assert.equal(evalFormula('=1+2=3'), 1);
+        assert.equal(evalFormula('=1<2<1'), 0); // (1<2)<1
+    });
+
+    test('comparisons', () => {
+        assert.equal(evalFormula('=2=2'), 1);
+        assert.equal(evalFormula('=2<>2'), 0);
+        assert.equal(evalFormula('=1<2'), 1);
+        assert.equal(evalFormula('=1>2'), 0);
+        assert.equal(evalFormula('=2<=2'), 1);
+        assert.equal(evalFormula('=1>=2'), 0);
+    });
+
+    test('references', () => {
+        assert.equal(evalFormula('=A1', { A1: 'hi' }), 'hi');
+        assert.equal(evalFormula('=(A1)', { A1: 'hi' }), 'hi');
+        assert.equal(evalFormula('=A1'), 0);
+        assert.equal(evalFormula('=A1+1'), 1);
+        assert.equal(evalFormula('=A1+B2', { A1: '2', B2: '=A1*10' }), 22);
+    });
+
+    test('functions', () => {
+        const cells = { A1: '1', B1: 'x', A2: '3', B2: '4', C1: '=A1+A2' };
+        assert.equal(evalFormula('=SUM(A1:B2)', cells), 8);
+        assert.equal(evalFormula('=sum(B2:A1, 10, A1)', cells), 19);
+        assert.equal(evalFormula('=COUNT(A1:C3)', cells), 4);
+        assert.equal(evalFormula('=COUNT(B1, A9, 2)', cells), 1);
+        assert.equal(evalFormula('=MIN(A1:B2)', cells), 1);
+        assert.equal(evalFormula('=MAX(A1:B2, -1)', cells), 4);
+        assert.equal(evalFormula('=MIN(B1, D1:D9)', cells), 0);
+        assert.equal(evalFormula('=MAX()'), 0);
+        assert.equal(evalFormula('=SUM()'), 0);
+        assert.equal(evalFormula('=SUM(A1:A1)', cells), 1);
+        assert.equal(evalFormula('=SUM(A1:Z99998)', cells), 12);
+    });
+
+    test('IF', () => {
+        assert.equal(evalFormula('=IF(1, 2, 3)'), 2);
+        assert.equal(evalFormula('=IF(0, 2, 3)'), 3);
+        assert.equal(evalFormula('=IF(-0.5, 2, 3)'), 2);
+        assert.equal(evalFormula('=IF(A1, 2, 3)'), 3);
+        assert.equal(evalFormula('=if(A1>1, A2, 3)', { A1: '5', A2: 'yes' }), 'yes');
+        assert.equal(evalFormula('=IF(1, 2, 1/0)'), 2);
+        assert.equal(evalFormula('=IF(0, 1/0, 3)'), 3);
+        assert.equal(evalFormula('=IF(1, 1/0, 3)'), '#DIV/0!');
+        assert.equal(evalFormula('=IF(A1, 2, 3)', { A1: 'x' }), '#VALUE!');
+    });
+});
+
+describe('errors', () => {
+    test('#PARSE!', () => {
+        for (const f of ['=', '=1+', '=(1', '=1)', '=A1:B2', '=SUM(A1:B2+1)', '=SUM((A1:B2))',
+            '=IF(1,2)', '=IF(1,2,3,4)', '=IF()', '=1 2', '=foo', '=SUM(1,)', '=+1', '=A1B', '=1$']) {
+            assert.equal(evalFormula(f), '#PARSE!', f);
+        }
+    });
+
+    test('#NAME?', () => {
+        assert.equal(evalFormula('=FOO(1)'), '#NAME?');
+        assert.equal(evalFormula('=1+avg(A1:A3)'), '#NAME?');
+    });
+
+    test('#REF!', () => {
+        assert.equal(evalFormula('=A0'), '#REF!');
+        assert.equal(evalFormula('=AA1+1'), '#REF!');
+        assert.equal(evalFormula('=A100000'), '#REF!');
+        assert.equal(evalFormula('=SUM(A1:AA2)'), '#REF!');
+    });
+
+    test('#VALUE!', () => {
+        assert.equal(evalFormula('=A1+1', { A1: 'x' }), '#VALUE!');
+        assert.equal(evalFormula('=-A1', { A1: 'x' }), '#VALUE!');
+        assert.equal(evalFormula('=A1=A1', { A1: 'x' }), '#VALUE!');
+    });
+
+    test('#DIV/0!', () => {
+        assert.equal(evalFormula('=1/0'), '#DIV/0!');
+        assert.equal(evalFormula('=1/A1'), '#DIV/0!');
+    });
+
+    test('propagation: first error left to right wins', () => {
+        assert.equal(evalFormula('=A0+1/0'), '#REF!');
+        assert.equal(evalFormula('=1/0+A0'), '#DIV/0!');
+        assert.equal(evalFormula('=A1*2', { A1: '=1/0' }), '#DIV/0!');
+        assert.equal(evalFormula('=SUM(1, A1, A2)', { A1: '=A0', A2: '=1/0' }), '#REF!');
+        // Range order is row by row: B1 comes before A2.
+        assert.equal(evalFormula('=SUM(A1:B2)', { A2: '=1/0', B1: '=A0' }), '#REF!');
+        assert.equal(evalFormula('=COUNT(A1)', { A1: '=FOO()' }), '#NAME?');
+        assert.equal(evalFormula('=A1', { A1: '=(' }), '#PARSE!');
+        assert.equal(evalFormula('=IF(A1, 1, 2)', { A1: '=1/0' }), '#DIV/0!');
+    });
+});
+
+describe('cycles', () => {
+    test('self reference', () => {
+        const s = sheet({ A1: '=A1' });
+        assert.equal(s.get('A1'), '#CYCLE!');
+        assert.equal(sheet({ A1: '=SUM(A1:B2)' }).get('A1'), '#CYCLE!');
+    });
+
+    test('every cell on the cycle, and dependents via propagation', () => {
+        const s = sheet({ A1: '=B1+1', B1: '=C1+1', C1: '=A1+1', D1: '=A1', E1: '5' });
+        for (const r of ['A1', 'B1', 'C1', 'D1']) assert.equal(s.get(r), '#CYCLE!', r);
+        assert.equal(s.get('E1'), 5);
+    });
+
+    test('detected regardless of values (IF branches, ranges, unknown functions)', () => {
+        assert.equal(sheet({ A1: '=IF(1, 2, B1)', B1: '=A1' }).get('B1'), '#CYCLE!');
+        assert.equal(sheet({ A1: '=IF(1, 2, B1)', B1: '=A1' }).get('A1'), '#CYCLE!');
+        assert.equal(sheet({ A1: '=COUNT(B1:B3)', B3: '=A1' }).get('A1'), '#CYCLE!');
+        assert.equal(sheet({ A1: '=FOO(B1)', B1: '=A1' }).get('A1'), '#CYCLE!');
+    });
+
+    test('dependent outside cycle that IF skips is not a cycle', () => {
+        const s = sheet({ A1: '=B1', B1: '=A1', C1: '=IF(1, 7, A1)' });
+        assert.equal(s.get('C1'), 7);
+    });
+
+    test('breaking and re-creating a cycle', () => {
+        const s = sheet({ A1: '=B1+1', B1: '=A1+1', C1: '=B1*2' });
+        assert.equal(s.get('C1'), '#CYCLE!');
+        s.set('A1', '10');
+        assert.equal(s.get('A1'), 10);
+        assert.equal(s.get('B1'), 11);
+        assert.equal(s.get('C1'), 22);
+        s.set('A1', '=C1');
+        assert.equal(s.get('B1'), '#CYCLE!');
+        assert.equal(s.get('C1'), '#CYCLE!');
+        s.set('B1', '');
+        assert.equal(s.get('A1'), 0);
+        assert.equal(s.get('C1'), 0);
+    });
+
+    test('cycle created through a range when a cell is filled in later', () => {
+        const s = sheet({ A1: '=SUM(B1:B5)', B2: '3' });
+        assert.equal(s.get('A1'), 3);
+        s.set('B4', '=A1');
+        assert.equal(s.get('A1'), '#CYCLE!');
+        s.set('B4', '4');
+        assert.equal(s.get('A1'), 7);
+    });
+});
+
+describe('recalculation', () => {
+    test('get reflects every set', () => {
+        const s = sheet({ A1: '1', A2: '=A1*2', A3: '=SUM(A1:A2)' });
+        assert.equal(s.get('A3'), 3);
+        s.set('A1', '5');
+        assert.equal(s.get('A3'), 15);
+        s.set('A2', 'text');
+        assert.equal(s.get('A3'), 5);
+        s.set('A1', '');
+        assert.equal(s.get('A3'), 0);
+        s.set('A3', '=A2');
+        assert.equal(s.get('A3'), 'text');
+    });
+
+    test('20,000-cell chain in any order, fast and without stack overflow', () => {
+        const start = Date.now();
+        const s = new Sheet();
+        const n = 20000;
+        const order = Array.from({ length: n }, (_, i) => i + 1);
+        // Deterministic shuffle.
+        let seed = 42;
+        for (let i = n - 1; i > 0; i--) {
+            seed = (seed * 1103515245 + 12345) % 2147483648;
+            const j = seed % (i + 1);
+            [order[i], order[j]] = [order[j], order[i]];
+        }
+        for (const r of order) s.set(`A${r}`, r === 1 ? '1' : `=A${r - 1}+1`);
+        assert.equal(s.get('A20000'), 20000);
+        s.set('A1', '101');
+        assert.equal(s.get('A20000'), 20100);
+        assert.equal(s.get('A10000'), 10100);
+        assert.ok(Date.now() - start < 2000, `took ${Date.now() - start}ms`);
+    });
+
+    test('long cycle does not overflow', () => {
+        const s = new Sheet();
+        for (let r = 1; r <= 20000; r++) s.set(`B${r}`, `=B${r === 20000 ? 1 : r + 1}`);
+        assert.equal(s.get('B1'), '#CYCLE!');
+        s.set('B20000', '7');
+        assert.equal(s.get('B1'), 7);
+    });
+});
