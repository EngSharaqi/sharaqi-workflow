-// Spreadsheet engine. Not implemented yet.
+// Spreadsheet engine.
+//
+// Design:
+// - Cells are keyed by a numeric id, (row - 1) * 26 + col, so sorting ids gives
+//   row-major order (needed for left-to-right error precedence inside ranges).
+// - Formulas are parsed once on `set`; the parse records the static references
+//   (single cells and ranges) written anywhere in the formula.
+// - Formula values are computed lazily on `get` and cached. Invariant: a cached
+//   formula only depends on cached cells. `set` therefore invalidates the edited
+//   cell and, transitively, every cached formula that references it.
+// - Computing an uncached cell runs an iterative Tarjan SCC over the uncached
+//   formula cells it reaches. Tarjan emits SCCs dependencies-first, so each SCC
+//   can be resolved as soon as it is emitted: a multi-cell SCC or a self-loop is
+//   a cycle (#CYCLE! for all members), otherwise the single formula is evaluated
+//   against already-cached inputs. No recursion over the dependency graph, so
+//   long chains cannot overflow the stack.
+
+const COLS = 26;
+const MAX_ROW = 99999;
+
+class CellError {
+    constructor(code) {
+        this.code = code;
+    }
+}
+
+const PARSE = new CellError('#PARSE!');
+const NAME = new CellError('#NAME?');
+const REF = new CellError('#REF!');
+const VALUE = new CellError('#VALUE!');
+const DIV0 = new CellError('#DIV/0!');
+const CYCLE = new CellError('#CYCLE!');
+
+class ParseError extends Error {}
+
+// Returns {col, row} (col 0-based, row 1-based) or null if not a valid reference.
+function parseRef(text) {
+    const m = /^([A-Za-z])([1-9][0-9]{0,4})$/.exec(text);
+    if (!m) return null;
+    return { col: m[1].toUpperCase().charCodeAt(0) - 65, row: Number(m[2]) };
+}
+
+function idOf(col, row) {
+    return (row - 1) * COLS + col;
+}
+
+function refToId(ref) {
+    const p = typeof ref === 'string' ? parseRef(ref) : null;
+    if (!p) throw new RangeError(`Invalid cell reference: ${ref}`);
+    return idOf(p.col, p.row);
+}
+
+// ---------- tokenizer ----------
+
+function tokenize(src) {
+    const tokens = [];
+    let i = 0;
+    while (i < src.length) {
+        const ch = src[i];
+        if (/\s/.test(ch)) {
+            i++;
+            continue;
+        }
+        const rest = src.slice(i);
+        let m;
+        if ((m = /^(?:[0-9]+(?:\.[0-9]*)?|\.[0-9]+)(?:[eE][+-]?[0-9]+)?/.exec(rest))) {
+            tokens.push({ type: 'num', value: Number(m[0]) });
+        } else if ((m = /^[A-Za-z]+[0-9]+/.exec(rest))) {
+            tokens.push({ type: 'ref', text: m[0] });
+        } else if ((m = /^[A-Za-z]+/.exec(rest))) {
+            tokens.push({ type: 'name', text: m[0].toUpperCase() });
+        } else if ((m = /^(?:<=|>=|<>|[-+*/()<>=,:])/.exec(rest))) {
+            tokens.push({ type: 'op', text: m[0] });
+        } else {
+            throw new ParseError();
+        }
+        i += m[0].length;
+    }
+    return tokens;
+}
+
+// ---------- parser ----------
+// AST nodes:
+//   {t:'num', v} | {t:'ref', id|null} | {t:'range', box|null}
+//   {t:'neg', a} | {t:'bin', op, a, b} | {t:'fn', name, args}
+
+const CMP_OPS = new Set(['=', '<>', '<', '>', '<=', '>=']);
+const KNOWN_FNS = new Set(['SUM', 'MIN', 'MAX', 'COUNT', 'IF']);
+
+function parseFormula(src) {
+    const tokens = tokenize(src);
+    let pos = 0;
+    const refs = new Set();
+    const ranges = [];
+
+    const peek = (k = 0) => tokens[pos + k];
+    const isOp = (tok, text) => tok !== undefined && tok.type === 'op' && tok.text === text;
+    const expect = (text) => {
+        if (!isOp(peek(), text)) throw new ParseError();
+        pos++;
+    };
+
+    function refNode(text) {
+        const p = parseRef(text);
+        if (!p) return { t: 'ref', id: null };
+        const id = idOf(p.col, p.row);
+        refs.add(id);
+        return { t: 'ref', id };
+    }
+
+    function parseComparison() {
+        let a = parseAdditive();
+        while (peek() && peek().type === 'op' && CMP_OPS.has(peek().text)) {
+            const op = tokens[pos++].text;
+            a = { t: 'bin', op, a, b: parseAdditive() };
+        }
+        return a;
+    }
+
+    function parseAdditive() {
+        let a = parseMultiplicative();
+        while (isOp(peek(), '+') || isOp(peek(), '-')) {
+            const op = tokens[pos++].text;
+            a = { t: 'bin', op, a, b: parseMultiplicative() };
+        }
+        return a;
+    }
+
+    function parseMultiplicative() {
+        let a = parseUnary();
+        while (isOp(peek(), '*') || isOp(peek(), '/')) {
+            const op = tokens[pos++].text;
+            a = { t: 'bin', op, a, b: parseUnary() };
+        }
+        return a;
+    }
+
+    function parseUnary() {
+        if (isOp(peek(), '-')) {
+            pos++;
+            return { t: 'neg', a: parseUnary() };
+        }
+        return parsePrimary();
+    }
+
+    function parsePrimary() {
+        const tok = peek();
+        if (!tok) throw new ParseError();
+        pos++;
+        if (tok.type === 'num') return { t: 'num', v: tok.value };
+        if (tok.type === 'ref') {
+            // A range is only allowed as a whole function argument (see parseArg).
+            if (isOp(peek(), ':')) throw new ParseError();
+            return refNode(tok.text);
+        }
+        if (tok.type === 'name') return parseCall(tok.text);
+        if (isOp(tok, '(')) {
+            const e = parseComparison();
+            expect(')');
+            return e;
+        }
+        throw new ParseError();
+    }
+
+    function parseCall(name) {
+        expect('(');
+        const args = [];
+        if (isOp(peek(), ')')) {
+            pos++;
+        } else {
+            for (;;) {
+                args.push(parseArg());
+                if (isOp(peek(), ',')) {
+                    pos++;
+                    continue;
+                }
+                expect(')');
+                break;
+            }
+        }
+        if (name === 'IF' && args.length !== 3) throw new ParseError();
+        return { t: 'fn', name, args };
+    }
+
+    function parseArg() {
+        const a = peek(), colon = peek(1), b = peek(2), after = peek(3);
+        if (a && a.type === 'ref' && isOp(colon, ':') && b && b.type === 'ref'
+            && (isOp(after, ',') || isOp(after, ')'))) {
+            pos += 3;
+            const p = parseRef(a.text), q = parseRef(b.text);
+            if (!p || !q) return { t: 'range', box: null };
+            const box = {
+                c1: Math.min(p.col, q.col), c2: Math.max(p.col, q.col),
+                r1: Math.min(p.row, q.row), r2: Math.max(p.row, q.row),
+            };
+            ranges.push(box);
+            return { t: 'range', box };
+        }
+        return parseComparison();
+    }
+
+    const ast = parseComparison();
+    if (pos !== tokens.length) throw new ParseError();
+    return { ast, refs: [...refs], ranges };
+}
+
+function boxContains(box, id) {
+    const col = id % COLS, row = Math.floor(id / COLS) + 1;
+    return col >= box.c1 && col <= box.c2 && row >= box.r1 && row <= box.r2;
+}
+
+// ---------- Sheet ----------
+
 export class Sheet {
+    constructor() {
+        // id -> {kind: 'const', value} | {kind: 'formula', ast, refs, ranges}
+        this.cells = new Map();
+        this.formulaIds = new Set();
+        this.cache = new Map(); // formula id -> computed value
+        this.refBy = new Map(); // cell id -> Set of formula ids referencing it directly
+        this.rangeFormulas = new Map(); // formula id -> ranges it references
+    }
+
     set(ref, raw) {
-        throw new Error('not implemented');
+        const id = refToId(ref);
+        if (typeof raw !== 'string') throw new TypeError('Cell content must be a string');
+
+        this.#unregister(id);
+
+        const trimmed = raw.trim();
+        if (raw === '') {
+            // empty: nothing stored
+        } else if (trimmed.startsWith('=')) {
+            let parsed = null;
+            try {
+                parsed = parseFormula(trimmed.slice(1));
+            } catch (e) {
+                if (!(e instanceof ParseError)) throw e;
+            }
+            if (parsed) {
+                this.cells.set(id, { kind: 'formula', ...parsed });
+                this.#register(id);
+            } else {
+                this.cells.set(id, { kind: 'const', value: PARSE });
+            }
+        } else if (trimmed !== '' && Number.isFinite(Number(trimmed))) {
+            this.cells.set(id, { kind: 'const', value: Number(trimmed) });
+        } else {
