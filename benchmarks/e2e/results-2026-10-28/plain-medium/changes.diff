 const STATUSES = ['open', 'done'];
+const SORTS = ['created', '-created', 'title', '-title'];
+
+class QueryError extends Error {
+    constructor(field, message) {
+        super(message);
+        this.field = field;
+    }
+}
+
+// Missing -> default; present -> must be a plain decimal integer within [min, max].
+function intParam(params, name, def, min, max) {
+    const raw = params.get(name);
+    if (raw === null) return def;
+    const n = /^-?\d+$/.test(raw) ? Number(raw) : NaN;
+    if (!Number.isSafeInteger(n) || n < min || n > max) {
+        const range = max === Infinity ? `>= ${min}` : `between ${min} and ${max}`;
+        throw new QueryError(name, `${name} must be an integer ${range}`);
+    }
+    return n;
+}
+
+function parseListQuery(params) {
+    const status = params.get('status');
+    if (status !== null && !STATUSES.includes(status)) {
+        throw new QueryError('status', `status must be one of: ${STATUSES.join(', ')}`);
+    }
+    const sort = params.get('sort') ?? 'created';
+    if (!SORTS.includes(sort)) {
+        throw new QueryError('sort', `sort must be one of: ${SORTS.join(', ')}`);
+    }
+    return {
+        status,
+        q: params.get('q') ?? '',
+        sort,
+        page: intParam(params, 'page', 1, 1, Infinity),
+        limit: intParam(params, 'limit', 20, 1, 100),
+    };
+}
+
+function listTasks({ status, q, sort, page, limit }) {
+    const needle = q.toLowerCase();
+    const matches = store
+        .all()
+        .filter((t) => (status === null || t.status === status) && (!needle || t.title.toLowerCase().includes(needle)));
+
+    const key = sort.replace(/^-/, '');
+    const dir = sort.startsWith('-') ? -1 : 1;
+    const value = key === 'title' ? (t) => t.title.toLowerCase() : (t) => t.created;
+    matches.sort((a, b) => {
+        const va = value(a);
+        const vb = value(b);
+        if (va !== vb) return (va < vb ? -1 : 1) * dir;
+        return a.id - b.id;
+    });
+
+    const total = matches.length;
+    const start = (page - 1) * limit;
+    return {
+        items: matches.slice(start, start + limit),
+        page,
+        limit,
+        total,
+        totalPages: Math.ceil(total / limit),
+    };
+}
 
