+test('scale: chain in shuffled order', () => {
+    const t0 = Date.now();
+    const s = new Sheet();
+    const order = [];
+    for (let i = 1; i <= 20000; i++) order.push(i);
+    let seed = 12345;
+    for (let i = order.length - 1; i > 0; i--) {
+        seed = (seed * 1103515245 + 12345) % 2147483648;
+        const j = seed % (i + 1);
+        [order[i], order[j]] = [order[j], order[i]];
+    }
+    for (const i of order) s.set(`A${i}`, i === 1 ? '1' : `=A${i - 1}+1`);
+    assert.equal(s.get('A20000'), 20000);
+    s.set('A1', '0');
+    assert.equal(s.get('A20000'), 19999);
+    assert.ok(Date.now() - t0 < 2000);
+});
+
+test('range over a whole big column set does not blow up', () => {
+    const s = new Sheet();
+    for (let i = 1; i <= 2000; i++) s.set(`B${i}`, String(i));
+    s.set('A1', '=SUM(B1:B2000)');
+    s.set('A2', '=MAX(A1:Z99999)'); // includes A2 itself
+    assert.equal(s.get('A1'), 2001000);
+    assert.equal(s.get('A2'), '#CYCLE!');
+    s.set('A2', '=MAX(B1:Z99999)');
+    assert.equal(s.get('A2'), 2000);
+});
