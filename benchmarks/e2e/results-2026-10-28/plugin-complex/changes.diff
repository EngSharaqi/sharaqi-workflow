+// over cell depth, so long chains cannot overflow the stack).
+
+const MAX_COL = 26;
+const MAX_ROW = 99999;
+const MAX_NESTING = 1000;
+
+class Err {
+    constructor(code) {
+        this.code = code;
+    }
+}
+
+const E = {
+    PARSE: new Err('#PARSE!'),
+    NAME: new Err('#NAME?'),
+    REF: new Err('#REF!'),
+    VALUE: new Err('#VALUE!'),
+    DIV0: new Err('#DIV/0!'),
+    CYCLE: new Err('#CYCLE!'),
