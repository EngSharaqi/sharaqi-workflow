+                } else if (w.run !== run) {
+                    visit(w);
+                } else if (w.on) {
+                    if (w.idx < f.cell.low) f.cell.low = w.idx;
+                }
+                continue;
+            }
+            frames.pop();
+            const c = f.cell;
+            if (frames.length) {
+                const parent = frames[frames.length - 1].cell;
+                if (c.low < parent.low) parent.low = c.low;
+            }
+            if (c.low !== c.idx) continue;
+            const members = [];
+            let m;
+            do {
+                m = sccStack.pop();
+                m.on = false;
+                members.push(m);
+            } while (m !== c);
+            if (members.length > 1 || f.self) {
+                for (const x of members) {
+                    x.value = E.CYCLE;
+                    x.valid = true;
+                }
+            } else {
+                const v = this._ev(c.ast);
+                c.value = v === null ? 0 : v;
+                c.valid = true;
+            }
+        }
+    }
+
+    // ---- expression evaluation
+    // Values: number | string (text) | null (empty cell) | Err.
+
+    _ev(n) {
+        switch (n.t) {
+            case 'num':
+                return n.v;
+            case 'ref': {
+                const c = this.cells.get(n.key);
+                return c ? c.value : null;
+            }
+            case 'neg': {
+                const v = this._ev(n.x);
+                if (v instanceof Err) return v;
+                if (typeof v === 'string') return E.VALUE;
+                return 0 - (v === null ? 0 : v);
+            }
+            case 'bin': {
+                // Walk the left spine iteratively: long a+b+c+... chains.
+                const spine = [];
+                let cur = n;
+                while (cur.t === 'bin') {
+                    spine.push(cur);
+                    cur = cur.l;
+                }
+                let acc = this._ev(cur);
+                for (let i = spine.length - 1; i >= 0; i--) {
+                    acc = this._binop(spine[i].op, acc, spine[i].r);
+                }
+                return acc;
+            }
+            case 'call':
+                return this._call(n);
+            default:
+                // badref (and a range that somehow reached here)
+                return n.t === 'badref' ? E.REF : E.PARSE;
+        }
+    }
+
+    _binop(op, left, rightNode) {
+        if (left instanceof Err) return left;
+        const right = this._ev(rightNode);
+        if (right instanceof Err) return right;
+        if (typeof left === 'string' || typeof right === 'string') return E.VALUE;
+        const a = left === null ? 0 : left;
+        const b = right === null ? 0 : right;
+        let r;
+        switch (op) {
+            case '+': r = a + b; break;
+            case '-': r = a - b; break;
+            case '*': r = a * b; break;
+            case '/':
+                if (b === 0) return E.DIV0;
+                r = a / b;
+                break;
+            case '=': return a === b ? 1 : 0;
+            case '<>': return a !== b ? 1 : 0;
+            case '<': return a < b ? 1 : 0;
+            case '>': return a > b ? 1 : 0;
+            case '<=': return a <= b ? 1 : 0;
+            default: return a >= b ? 1 : 0; // '>='
+        }
+        return r === 0 ? 0 : r; // normalise -0
+    }
+
+    _call(n) {
+        if (n.name === 'IF') {
+            const cond = this._ev(n.args[0]);
+            if (cond instanceof Err) return cond;
+            if (typeof cond === 'string') return E.VALUE;
+            return this._ev(cond ? n.args[1] : n.args[2]);
+        }
+        if (!AGGREGATES.has(n.name)) return E.NAME;
+
+        let sum = 0;
+        let count = 0;
+        let min = Infinity;
+        let max = -Infinity;
+        const take = (v) => {
+            if (typeof v !== 'number') return;
+            sum += v;
+            count++;
+            if (v < min) min = v;
+            if (v > max) max = v;
+        };
+        for (const arg of n.args) {
+            if (arg.t === 'range') {
+                for (const c of this._rangeCells(arg)) {
+                    if (c.value instanceof Err) return c.value;
+                    take(c.value);
+                }
+            } else {
+                const v = this._ev(arg);
+                if (v instanceof Err) return v;
+                take(v);
+            }
+        }
+        switch (n.name) {
+            case 'SUM': return sum === 0 ? 0 : sum;
+            case 'COUNT': return count;
+            case 'MIN': return count ? min : 0;
+            default: return count ? max : 0;
+        }
     }
 }
diff --git a/test/sheet.test.js b/test/sheet.test.js
new file mode 100644
index 0000000..ff69818
--- /dev/null
+++ b/test/sheet.test.js
@@ -0,0 +1,555 @@
+import assert from 'node:assert/strict';
+import { test } from 'node:test';
+
+import { Sheet } from '../src/sheet.js';
+
+// Build a sheet from { ref: raw } and return it.
+function sheet(cells = {}) {
+    const s = new Sheet();
+    for (const [ref, raw] of Object.entries(cells)) s.set(ref, raw);
+    return s;
+}
+
+// Evaluate a single formula placed in Z1 of a sheet with the given cells.
+function f(formula, cells = {}) {
+    const s = sheet(cells);
+    s.set('Z1', formula);
+    return s.get('Z1');
+}
+
+test('references: case-insensitive, invalid ones throw RangeError', () => {
+    const s = new Sheet();
+    s.set('a1', '5');
+    assert.equal(s.get('A1'), 5);
+    assert.equal(s.get('a1'), 5);
+    s.set('Z99999', '7');
+    assert.equal(s.get('z99999'), 7);
+    for (const bad of ['A0', 'AA1', 'A100000', '1A', '', 'A', 'A-1', ' A1', 'A1 ', '[1', 'A01', 'A1.5']) {
+        assert.throws(() => s.set(bad, '1'), RangeError, `set ${bad}`);
+        assert.throws(() => s.get(bad), RangeError, `get ${bad}`);
+    }
+    assert.throws(() => s.get(undefined), RangeError);
+    assert.throws(() => s.set(null, '1'), RangeError);
+});
+
+test('set requires a string raw value', () => {
+    const s = new Sheet();
+    assert.throws(() => s.set('A1', 5), TypeError);
+});
+
+test('cell contents: numbers, text, clearing', () => {
+    const s = new Sheet();
+    assert.equal(s.get('A1'), null);
+    s.set('A1', '3');
+    s.set('A2', '-2.5');
+    s.set('A3', '1e3');
+    s.set('A4', ' 3 ');
+    s.set('A5', 'hello');
+    s.set('A6', '  padded text ');
+    s.set('A7', 'Infinity');
+    s.set('A8', '1e999');
+    assert.equal(s.get('A1'), 3);
+    assert.equal(s.get('A2'), -2.5);
+    assert.equal(s.get('A3'), 1000);
+    assert.equal(s.get('A4'), 3);
+    assert.equal(s.get('A5'), 'hello');
+    assert.equal(s.get('A6'), '  padded text ');
+    assert.equal(s.get('A7'), 'Infinity');
+    assert.equal(s.get('A8'), '1e999');
+    s.set('A1', '');
+    assert.equal(s.get('A1'), null);
+    s.set('A5', '');
+    assert.equal(s.get('A5'), null);
+});
+
+test('whitespace-only raw text is kept as text, not 0', () => {
+    const s = sheet({ A1: '   ' });
+    assert.equal(s.get('A1'), '   ');
+});
+
+test('text that looks like an error is plain text, not an error', () => {
+    const s = sheet({ A1: '#DIV/0!', B1: '=A1', C1: '=A1+1', D1: '=SUM(A1)' });
+    assert.equal(s.get('A1'), '#DIV/0!');
+    assert.equal(s.get('B1'), '#DIV/0!');
+    assert.equal(s.get('C1'), '#VALUE!');
+    assert.equal(s.get('D1'), 0);
+});
+
+test('a raw starting with = is a formula (leading space makes it text)', () => {
+    const s = sheet({ A1: '=1+1', A2: ' =1+1' });
+    assert.equal(s.get('A1'), 2);
+    assert.equal(s.get('A2'), ' =1+1');
+});
+
+test('literals, operators, precedence, associativity', () => {
+    assert.equal(f('=2'), 2);
+    assert.equal(f('=3.5'), 3.5);
+    assert.equal(f('=.5+1'), 1.5);
+    assert.equal(f('=1+2*3'), 7);
+    assert.equal(f('=(1+2)*3'), 9);
+    assert.equal(f('=10-4-3'), 3);
+    assert.equal(f('=100/10/5'), 2);
+    assert.equal(f('=2*3/4'), 1.5);
+    assert.equal(f('=-2*3'), -6);
+    assert.equal(f('=--2'), 2);
+    assert.equal(f('=2--1'), 3);
+    assert.equal(f('=-(1+2)'), -3);
+    assert.equal(f('= 1 + 2 '), 3);
