+
+// Strict reference parsing used by set/get.
+function parseRef(ref) {
+    if (typeof ref !== 'string') {
+        throw new RangeError(`Invalid cell reference: ${String(ref)}`);
+    }
+    const m = REF_RE.exec(ref);
+    if (!m) throw new RangeError(`Invalid cell reference: ${ref}`);
+    const col = m[1].toUpperCase().charCodeAt(0) - 65;
+    const row = Number(m[2]);
+    return { col, row, key: makeKey(col, row) };
+}
+
+// ---------------------------------------------------------------- tokenizer
+
+const WS_RE = /\s*/y;
+const TOKEN_RE = /(\d+\.?\d*|\.\d+)|([A-Za-z][A-Za-z0-9_]*)|(<>|<=|>=|[-+*/(),:=<>])/y;
+
+function tokenize(src) {
+    const toks = [];
+    let pos = 0;
+    for (;;) {
+        WS_RE.lastIndex = pos;
+        WS_RE.exec(src);
+        pos = WS_RE.lastIndex;
+        if (pos >= src.length) break;
+        TOKEN_RE.lastIndex = pos;
+        const m = TOKEN_RE.exec(src);
+        if (!m) throw new ParseError('bad character');
+        if (m[1] !== undefined) toks.push({ t: 'num', v: Number(m[1]) });
+        else if (m[2] !== undefined) toks.push({ t: 'id', v: m[2] });
+        else toks.push({ t: 'op', v: m[3] });
+        pos = TOKEN_RE.lastIndex;
+    }
+    return toks;
+}
+
+// ------------------------------------------------------------------- parser
+
+const AGGREGATES = new Set(['SUM', 'MIN', 'MAX', 'COUNT']);
+const CMP_OPS = new Set(['=', '<>', '<', '>', '<=', '>=']);
+const LOOSE_REF_RE = /^([A-Za-z]+)([0-9]+)$/;
