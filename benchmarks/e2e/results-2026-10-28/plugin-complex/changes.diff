+    const strict = REF_RE.exec(id);
+    if (!strict) return { t: 'badref' };
+    const col = strict[1].toUpperCase().charCodeAt(0) - 65;
+    const row = Number(strict[2]);
+    return { t: 'ref', col, row, key: makeKey(col, row) };
+}
+
+function parseFormula(src) {
+    const toks = tokenize(src);
+    let pos = 0;
+    let depth = 0;
+
+    const isOp = (v) => pos < toks.length && toks[pos].t === 'op' && toks[pos].v === v;
+    const fail = () => {
+        throw new ParseError('syntax');
+    };
+    const enter = () => {
+        if (++depth > MAX_NESTING) fail();
+    };
+
+    function parseComparison() {
+        let left = parseAdditive();
+        while (pos < toks.length && toks[pos].t === 'op' && CMP_OPS.has(toks[pos].v)) {
+            const op = toks[pos++].v;
+            left = { t: 'bin', op, l: left, r: parseAdditive() };
+        }
+        return left;
+    }
+
+    function parseAdditive() {
+        let left = parseMultiplicative();
+        while (isOp('+') || isOp('-')) {
+            const op = toks[pos++].v;
+            left = { t: 'bin', op, l: left, r: parseMultiplicative() };
+        }
+        return left;
+    }
+
+    function parseMultiplicative() {
+        let left = parseUnary();
+        while (isOp('*') || isOp('/')) {
+            const op = toks[pos++].v;
+            left = { t: 'bin', op, l: left, r: parseUnary() };
+        }
+        return left;
+    }
+
+    function parseUnary() {
+        if (isOp('-')) {
+            pos++;
+            enter();
+            const x = parseUnary();
+            depth--;
+            return { t: 'neg', x };
+        }
+        return parsePrimary();
+    }
+
+    function parsePrimary() {
+        const tok = toks[pos];
+        if (!tok) fail();
+        if (tok.t === 'num') {
+            pos++;
+            return { t: 'num', v: tok.v };
+        }
+        if (tok.t === 'id') {
+            pos++;
+            if (isOp('(')) return parseCall(tok.v.toUpperCase());
+            const ref = refNodeFromId(tok.v);
+            if (!ref) fail();
+            return ref;
+        }
+        if (tok.v === '(') {
+            pos++;
+            enter();
+            const inner = parseComparison();
+            depth--;
+            if (!isOp(')')) fail();
+            pos++;
+            return inner; // parentheses are transparent
+        }
+        return fail();
+    }
+
+    function parseArg() {
+        // range: ref ':' ref directly followed by ',' or ')'
+        const a = toks[pos];
+        const colon = toks[pos + 1];
+        const b = toks[pos + 2];
+        const after = toks[pos + 3];
+        if (
+            a && a.t === 'id' && colon && colon.t === 'op' && colon.v === ':' &&
+            b && b.t === 'id' && after && after.t === 'op' && (after.v === ',' || after.v === ')')
+        ) {
+            const r1 = refNodeFromId(a.v);
+            const r2 = refNodeFromId(b.v);
+            if (!r1 || !r2) fail();
+            pos += 3;
+            if (r1.t === 'badref' || r2.t === 'badref') return { t: 'badref' };
+            return {
+                t: 'range',
+                c1: Math.min(r1.col, r2.col),
+                c2: Math.max(r1.col, r2.col),
+                r1: Math.min(r1.row, r2.row),
+                r2: Math.max(r1.row, r2.row),
+            };
+        }
+        return parseComparison();
+    }
+
+    function parseCall(name) {
+        pos++; // '('
+        enter();
+        const args = [];
+        if (isOp(')')) {
+            pos++;
+        } else {
+            for (;;) {
+                args.push(parseArg());
+                if (isOp(',')) {
+                    pos++;
+                } else if (isOp(')')) {
+                    pos++;
+                    break;
+                } else {
+                    fail();
+                }
+            }
+        }
+        depth--;
+        if (name === 'IF') {
+            if (args.length !== 3 || args.some((a) => a.t === 'range')) fail();
+        }
+        return { t: 'call', name, args };
+    }
+
+    const ast = parseComparison();
+    if (pos !== toks.length) fail();
+    return ast;
+}
+
+// Collect point references and ranges written in an AST (all IF branches).
+function collectDeps(ast) {
+    const points = new Set();
+    const ranges = [];
+    const stack = [ast];
+    while (stack.length) {
+        const n = stack.pop();
+        switch (n.t) {
+            case 'ref':
+                points.add(n.key);
+                break;
+            case 'range':
+                ranges.push(n);
+                break;
+            case 'bin':
+                stack.push(n.l, n.r);
+                break;
+            case 'neg':
+                stack.push(n.x);
+                break;
+            case 'call':
+                for (const a of n.args) stack.push(a);
+                break;
+            default:
+                break;
+        }
+    }
+    return { points, ranges };
+}
+
+// -------------------------------------------------------------------- sheet
+
+function parseRaw(raw) {
+    if (raw === '') return null;
+    const trimmed = raw.trim();
+    if (trimmed !== '') {
+        const n = Number(trimmed);
+        if (Number.isFinite(n)) return { kind: 'num', value: n };
+    }
+    if (raw.startsWith('=')) return { kind: 'formula' };
+    return { kind: 'text', value: raw };
+}
+
 export class Sheet {
+    constructor() {
+        this.cells = new Map(); // key -> cell
+        this.dependents = new Map(); // key -> Set of formula-cell keys (point refs)
+        this.rangeOwners = new Set(); // keys of formula cells that contain ranges
+        this.run = 0;
+    }
+
     set(ref, raw) {
-        throw new Error('not implemented');
+        const { col, row, key } = parseRef(ref);
+        if (typeof raw !== 'string') {
+            throw new TypeError('raw must be a string');
+        }
+
+        this._unregister(key);
+
+        const parsed = parseRaw(raw);
+        if (!parsed) {
+            this.cells.delete(key);
+        } else if (parsed.kind === 'formula') {
+            const cell = {
+                key, col, row, kind: 'formula', ast: null, points: null, ranges: null,
+                value: null, valid: false, run: 0, idx: 0, low: 0, on: false,
+            };
+            try {
+                cell.ast = parseFormula(raw.slice(1));
+            } catch (e) {
+                // ParseError, or a stack overflow from absurd nesting.
+                if (!(e instanceof ParseError) && !(e instanceof RangeError)) throw e;
+                cell.value = E.PARSE;
+                cell.valid = true;
+            }
+            this.cells.set(key, cell);
+            if (cell.ast) this._register(cell);
+        } else {
+            this.cells.set(key, {
+                key, col, row, kind: parsed.kind, value: parsed.value, valid: true,
+            });
+        }
+        this._invalidate(key);
     }
 
     get(ref) {
-        throw new Error('not implemented');
+        const { key } = parseRef(ref);
+        const cell = this.cells.get(key);
+        if (!cell) return null;
+        if (!cell.valid) this._compute(cell);
+        const v = cell.value;
+        return v instanceof Err ? v.code : v;
+    }
+
+    // ---- dependency bookkeeping
+
+    _register(cell) {
+        const { points, ranges } = collectDeps(cell.ast);
+        cell.points = points;
+        cell.ranges = ranges;
+        for (const p of points) {
+            let s = this.dependents.get(p);
+            if (!s) this.dependents.set(p, (s = new Set()));
+            s.add(cell.key);
+        }
+        if (ranges.length) this.rangeOwners.add(cell.key);
+    }
+
+    _unregister(key) {
+        const old = this.cells.get(key);
+        if (!old || old.kind !== 'formula') return;
+        if (old.points) {
+            for (const p of old.points) {
+                const s = this.dependents.get(p);
+                if (s) {
+                    s.delete(key);
+                    if (s.size === 0) this.dependents.delete(p);
+                }
+            }
+        }
+        this.rangeOwners.delete(key);
+    }
+
+    // Invariant: a valid cell has only valid dependencies, so an already
+    // invalid cell has only invalid dependents and the walk can stop there.
+    _invalidate(startKey) {
+        const stack = [startKey];
+        while (stack.length) {
+            const k = stack.pop();
+            const ds = this.dependents.get(k);
+            if (ds) {
+                for (const dk of ds) {
+                    const c = this.cells.get(dk);
+                    if (c && c.valid) {
+                        c.valid = false;
+                        stack.push(dk);
+                    }
+                }
+            }
+            if (this.rangeOwners.size) {
+                const col = k.charCodeAt(0) - 65;
+                const row = Number(k.slice(1));
