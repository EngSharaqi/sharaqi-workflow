+                            c.valid = false;
+                            stack.push(ok);
+                            break;
+                        }
+                    }
+                }
+            }
+        }
+    }
+
+    // ---- evaluation driver (iterative Tarjan)
+
+    _successors(cell) {
+        const out = [];
+        for (const p of cell.points) {
+            const c = this.cells.get(p);
+            if (c) out.push(c);
+        }
+        for (const r of cell.ranges) {
+            for (const c of this._rangeCells(r)) out.push(c);
+        }
+        return out;
+    }
+
+    // Existing cells inside a range, in row-major order.
+    _rangeCells(r) {
+        const out = [];
+        const area = (r.c2 - r.c1 + 1) * (r.r2 - r.r1 + 1);
+        if (area <= this.cells.size) {
+            for (let row = r.r1; row <= r.r2; row++) {
+                for (let col = r.c1; col <= r.c2; col++) {
+                    const c = this.cells.get(makeKey(col, row));
+                    if (c) out.push(c);
+                }
+            }
+        } else {
+            for (const c of this.cells.values()) {
+                if (c.col >= r.c1 && c.col <= r.c2 && c.row >= r.r1 && c.row <= r.r2) {
+                    out.push(c);
+                }
+            }
+            out.sort((a, b) => a.row - b.row || a.col - b.col);
+        }
+        return out;
+    }
+
+    _compute(target) {
+        const run = ++this.run;
+        let index = 0;
+        const sccStack = [];
+        const frames = [];
+
+        const visit = (cell) => {
+            cell.run = run;
+            cell.idx = cell.low = index++;
+            cell.on = true;
+            sccStack.push(cell);
+            frames.push({ cell, succ: this._successors(cell), i: 0, self: false });
+        };
