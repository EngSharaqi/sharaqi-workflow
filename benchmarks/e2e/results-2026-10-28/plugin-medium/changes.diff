diff --git a/test/list.test.js b/test/list.test.js
new file mode 100644
index 0000000..5a9b6dc
--- /dev/null
+++ b/test/list.test.js
@@ -0,0 +1,97 @@
+import assert from 'node:assert/strict';
+import { beforeEach, test } from 'node:test';
+
+import * as store from '../src/store.js';
+import { withServer } from './helpers.js';
+
+beforeEach(() =>
+    store.reset([
+        { title: 'banana', status: 'open', created: '2024-01-02T00:00:00Z' },
+        { title: 'Apple', status: 'done', created: '2024-01-01T00:00:00Z' },
+        { title: 'cherry', status: 'open', created: '2024-01-02T00:00:00Z' },
+        { title: 'apple pie', status: 'open', created: '2024-01-03T00:00:00Z' },
+    ]),
+);
+
+const get = async (base, qs = '') => {
+    const r = await fetch(`${base}/tasks${qs}`);
+    return { status: r.status, body: await r.json() };
+};
+const ids = (b) => b.items.map((t) => t.id);
+
+test('defaults: created asc, id tiebreak, envelope', () =>
+    withServer(async (base) => {
+        const { status, body } = await get(base);
+        assert.equal(status, 200);
+        assert.deepEqual(ids(body), [2, 1, 3, 4]);
+        assert.deepEqual([body.page, body.limit, body.total, body.totalPages], [1, 20, 4, 1]);
+    }));
+
+test('sort -created and ties by id ascending', () =>
+    withServer(async (base) => {
+        assert.deepEqual(ids((await get(base, '?sort=-created')).body), [4, 1, 3, 2]);
+    }));
+
+test('title sorting is case-insensitive', () =>
+    withServer(async (base) => {
+        assert.deepEqual(ids((await get(base, '?sort=title')).body), [2, 4, 1, 3]);
+        assert.deepEqual(ids((await get(base, '?sort=-title')).body), [3, 1, 4, 2]);
+    }));
+
+test('status filter', () =>
+    withServer(async (base) => {
+        const { body } = await get(base, '?status=done');
+        assert.deepEqual(ids(body), [2]);
+        assert.equal(body.total, 1);
+    }));
+
+test('q is case-insensitive substring; empty q is no filter', () =>
+    withServer(async (base) => {
+        assert.deepEqual(ids((await get(base, '?q=APPLE')).body), [2, 4]);
+        assert.equal((await get(base, '?q=')).body.total, 4);
+    }));
+
+test('pagination, page past the end, no matches', () =>
+    withServer(async (base) => {
+        const p2 = (await get(base, '?limit=3&page=2')).body;
+        assert.deepEqual(ids(p2), [4]);
+        assert.deepEqual([p2.total, p2.totalPages], [4, 2]);
+        const past = await get(base, '?limit=3&page=9');
+        assert.equal(past.status, 200);
+        assert.deepEqual([past.body.items, past.body.total], [[], 4]);
+        const none = (await get(base, '?q=zzz')).body;
+        assert.deepEqual([none.items, none.total, none.totalPages], [[], 0, 0]);
+    }));
+
+test('invalid values are 400 naming the field', () =>
+    withServer(async (base) => {
+        const cases = [
+            ['status=foo', 'status'],
+            ['status=', 'status'],
+            ['sort=bogus', 'sort'],
+            ['page=0', 'page'],
+            ['page=2.5', 'page'],
+            ['page=abc', 'page'],
+            ['page=', 'page'],
+            ['page=-1', 'page'],
+            ['limit=0', 'limit'],
+            ['limit=101', 'limit'],
+            ['limit=1.5', 'limit'],
+            ['limit=abc', 'limit'],
+        ];
+        for (const [qs, field] of cases) {
+            const { status, body } = await get(base, `?${qs}`);
+            assert.equal(status, 400, qs);
+            assert.equal(body.error.field, field, qs);
+            assert.equal(typeof body.error.message, 'string', qs);
+        }
+    }));
+
+test('limit bounds and unknown params', () =>
+    withServer(async (base) => {
+        assert.equal((await get(base, '?limit=100')).body.limit, 100);
+        assert.equal((await get(base, '?limit=1')).body.items.length, 1);
+        const r = await get(base, '?foo=bar');
+        assert.equal(r.status, 200);
+        assert.equal(r.body.total, 4);
+    }));
