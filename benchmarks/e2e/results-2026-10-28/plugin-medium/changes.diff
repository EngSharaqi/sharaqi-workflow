 const STATUSES = ['open', 'done'];
+const SORTS = ['created', '-created', 'title', '-title'];
+
+function bad(field, message) {
+    return { error: { field, message } };
+}
+
+function parseInt1(raw, field, def, min, max) {
+    if (raw === null) return { value: def };
+    if (!/^\d+$/.test(raw)) return bad(field, `${field} must be an integer`);
+    const n = Number(raw);
+    if (n < min || (max !== undefined && n > max)) {
+        return bad(field, max === undefined ? `${field} must be >= ${min}` : `${field} must be between ${min} and ${max}`);
+    }
+    return { value: n };
+}
+
+function listTasks(params) {
+    const status = params.get('status');
+    if (status !== null && !STATUSES.includes(status)) return bad('status', 'status must be open or done');
+    const sort = params.get('sort') ?? 'created';
+    if (!SORTS.includes(sort)) return bad('sort', `sort must be one of ${SORTS.join(', ')}`);
+    const page = parseInt1(params.get('page'), 'page', 1, 1);
+    if (page.error) return page;
+    const limit = parseInt1(params.get('limit'), 'limit', 20, 1, 100);
+    if (limit.error) return limit;
+
+    const q = (params.get('q') ?? '').toLowerCase();
+    const desc = sort.startsWith('-');
+    const key = desc ? sort.slice(1) : sort;
+    const val = (t) => (key === 'title' ? t.title.toLowerCase() : t.created);
+
+    const matches = store
+        .all()
+        .filter((t) => (status === null || t.status === status) && (!q || t.title.toLowerCase().includes(q)))
+        .sort((a, b) => {
+            const x = val(a);
+            const y = val(b);
+            const c = x < y ? -1 : x > y ? 1 : 0;
+            return (desc ? -c : c) || a.id - b.id;
+        });
+
+    const total = matches.length;
+    const start = (page.value - 1) * limit.value;
+    return {
+        items: matches.slice(start, start + limit.value),
+        page: page.value,
+        limit: limit.value,
+        total,
+        totalPages: Math.ceil(total / limit.value),
+    };
+}
 
